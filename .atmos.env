# Environment variables for TF-Atmos
# These versions are used by install-dependencies.sh and other scripts

# Core tools
TERRAFORM_VERSION=1.16.3
ATMOS_VERSION=1.229.0
KUBECTL_VERSION=1.37.0
HELM_VERSION=4.3.0

# Security scanning tools
# tfsec is deprecated upstream; CI uses trivy (workflows/lint.yaml)
TFSEC_VERSION=1.28.14
TFLINT_VERSION=0.64.0
CHECKOV_VERSION=3.3.19

# Documentation tools
TERRAFORM_DOCS_VERSION=0.24.0

# AWS tools
AWS_CLI_VERSION=2.36.49
SESSION_MANAGER_VERSION=1.2.497.0

# Note: Kubernetes add-on versions are managed in stack YAML files, not here

# Terraform providers
TF_PROVIDER_AWS_VERSION=6.65.0
TF_PROVIDER_KUBERNETES_VERSION=3.2.1
TF_PROVIDER_HELM_VERSION=3.3.0
TF_PROVIDER_TLS_VERSION=4.4.1
TF_PROVIDER_TIME_VERSION=0.14.2
TF_PROVIDER_KUBECTL_VERSION=1.19.0

# CI/CD tools
YAMLLINT_VERSION=1.38.0
PRECOMMIT_VERSION=4.6.2

# Templating tools
COPIER_VERSION=9.18.2