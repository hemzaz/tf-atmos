pipeline {
    agent {
        docker {
            // Official Atmos image (Debian); Terraform 1.16.3 and the AWS CLI are
            // installed on demand by the Atmos toolchain
            image 'ghcr.io/cloudposse/atmos:1.229.0'
            args '-v $HOME/.aws:/root/.aws'
        }
    }
    
    parameters {
        string(name: 'TENANT', defaultValue: '', description: 'Tenant name')
        string(name: 'STAGE', defaultValue: '', description: 'Stage (dev, staging, prod)')
        string(name: 'ENVIRONMENT', defaultValue: '', description: 'Environment name (e.g. testenv-01)')
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action to execute')
        string(name: 'COMPONENT', defaultValue: '', description: 'Component instance to target, e.g. vpc/main (leave empty for all)')
        booleanParam(name: 'REQUIRE_APPROVAL', defaultValue: true, description: 'Require approval for production environments')
        choice(name: 'AWS_ROLE_SESSION_NAME', choices: ['atmos-jenkins-automation', 'atmos-jenkins-prod', 'atmos-jenkins-dev'], description: 'AWS role session name for cross-account access')
    }
    
    environment {
        ATMOS_VERSION = '1.229.0'
        AWS_CLI_TOOL = 'aws/aws-cli@2.36.49'
        MAX_RETRIES = 3
        // atmos.yaml name_template: <tenant>-<stage>-<environment>, e.g. fnx-prod-production
        STACK_NAME = "${params.TENANT}-${params.STAGE}-${params.ENVIRONMENT}"
        IS_PRODUCTION = "${params.STAGE == 'prod' ? 'true' : 'false'}"
    }
    
    stages {
        stage('Setup') {
            steps {
                script {
                    try {
                        // Verify Atmos is installed or install if missing
                        def atmosInstalled = sh(script: 'command -v atmos || echo "not installed"', returnStdout: true).trim()
                        if (atmosInstalled == "not installed") {
                            sh """
                                curl -fsSL -o /usr/local/bin/atmos https://github.com/cloudposse/atmos/releases/download/v${ATMOS_VERSION}/atmos_${ATMOS_VERSION}_linux_amd64
                                chmod +x /usr/local/bin/atmos
                            """
                        }
                        sh 'atmos version'
                        
                        // The account is stack configuration (settings.environment.account),
                        // not part of the stack name
                        env.ACCOUNT = sh(
                            script: "atmos describe stacks -s ${STACK_NAME} --process-functions=false --query '[.[].components.terraform[].settings.environment.account] | .[0]'",
                            returnStdout: true
                        ).trim()
                        echo "Stack ${STACK_NAME} targets account ${env.ACCOUNT}"
                        
                        // Set up AWS credentials for cross-account access if needed
                        if (env.ACCOUNT != 'dev') {
                            withCredentials([string(credentialsId: "${env.ACCOUNT}-role-arn", variable: 'AWS_ROLE_ARN')]) {
                                sh """
                                    export AWS_ROLE_ARN=${AWS_ROLE_ARN}
                                    export AWS_ROLE_SESSION_NAME=${params.AWS_ROLE_SESSION_NAME}
                                    atmos toolchain exec ${AWS_CLI_TOOL} -- sts get-caller-identity
                                """
                            }
                        }
                    } catch (Exception e) {
                        echo "Setup failed: ${e.message}"
                        error "Failed to set up environment. See logs for details."
                    }
                }
            }
        }
        
        stage('Repository Structure Detection') {
            steps {
                script {
                    try {
                        // Verify the stack exists (names come from atmos.yaml name_template)
                        def stackExists = sh(script: "atmos list stacks | grep -qx '${STACK_NAME}'", returnStatus: true)
                        if (stackExists != 0) {
                            error "Stack ${STACK_NAME} not found. Available stacks: " + sh(script: 'atmos list stacks', returnStdout: true).trim()
                        }
                        
                        // Verify the component instance exists in the stack if specified
                        if (params.COMPONENT) {
                            def componentExists = sh(script: "atmos describe component ${params.COMPONENT} -s ${STACK_NAME} --process-functions=false > /dev/null", returnStatus: true)
                            if (componentExists != 0) {
                                error "Component ${params.COMPONENT} not found in stack ${STACK_NAME}"
                            }
                        }
                    } catch (Exception e) {
                        echo "Repository detection failed: ${e.message}"
                        error "Failed to validate repository structure. See logs for details."
                    }
                }
            }
        }
        
        stage('Lint and Validate') {
            steps {
                script {
                    try {
                        retry(MAX_RETRIES) {
                            sh 'atmos workflow lint -f lint'
                            sh "atmos workflow validate -f validate -s ${STACK_NAME}"
                        }
                    } catch (Exception e) {
                        echo "Validation failed: ${e.message}"
                        error "Failed to validate code. Please fix linting or validation issues."
                    }
                }
            }
        }
        
        stage('Plan') {
            when {
                expression { params.ACTION == 'plan' || params.ACTION == 'apply' }
            }
            steps {
                script {
                    try {
                        retry(MAX_RETRIES) {
                            if (params.COMPONENT == '') {
                                sh "atmos workflow plan -f plan-environment -s ${STACK_NAME}"
                            } else {
                                sh "atmos terraform plan ${params.COMPONENT} -s ${STACK_NAME}"
                            }
                        }
                    } catch (Exception e) {
                        echo "Planning failed: ${e.message}"
                        error "Failed to create plan. See logs for details."
                    }
                    
                    // Archive the plan files Atmos wrote into the component directories
                    archiveArtifacts artifacts: 'components/terraform/**/*.planfile', allowEmptyArchive: true
                }
            }
        }
        
        stage('Approval') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' || params.ACTION == 'destroy' }
                    expression { params.REQUIRE_APPROVAL == true }
                    expression { env.IS_PRODUCTION == 'true' }
                }
            }
            steps {
                timeout(time: 24, unit: 'HOURS') {
                    input message: "Approve ${params.ACTION} for ${STACK_NAME}?", ok: 'Approve'
                }
            }
        }
        
        stage('Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    try {
                        retry(MAX_RETRIES) {
                            // Non-interactive CI path (the apply-environment workflow prompts per plan);
                            // approval for production is the Approval stage above
                            if (params.COMPONENT == '') {
                                sh "atmos terraform deploy -s ${STACK_NAME}"
                            } else {
                                sh "atmos terraform deploy ${params.COMPONENT} -s ${STACK_NAME}"
                            }
                        }
                    } catch (Exception e) {
                        echo "Apply failed: ${e.message}"
                        error "Failed to apply changes. See logs for details."
                    }
                }
            }
        }
        
        stage('Destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                script {
                    try {
                        retry(MAX_RETRIES) {
                            // destroy-environment asks for the stack name interactively; CI runs the same
                            // stack-wide destroy directly
                            if (params.COMPONENT == '') {
                                sh "atmos terraform destroy -s ${STACK_NAME} -auto-approve"
                            } else {
                                sh "atmos terraform destroy ${params.COMPONENT} -s ${STACK_NAME} -auto-approve"
                            }
                        }
                    } catch (Exception e) {
                        echo "Destroy failed: ${e.message}"
                        error "Failed to destroy resources. See logs for details."
                    }
                }
            }
        }
        
        stage('Validation Tests') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    try {
                        // Run post-apply validation to ensure resources are properly deployed
                        if (params.COMPONENT == '') {
                            sh "atmos workflow drift-detection -f drift-detection -s ${STACK_NAME} || true"
                        } else {
                            sh "atmos terraform plan ${params.COMPONENT} -s ${STACK_NAME} || true"
                        }
                    } catch (Exception e) {
                        echo "Post-apply validation returned warnings: ${e.message}"
                        // Don't fail the build, just warn
                    }
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully"
        }
        failure {
            echo "Pipeline failed. Review logs for details."
        }
    }
}