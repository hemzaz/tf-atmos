# =============================================================================
# DevOps Development Container
# =============================================================================
# Complete development environment with all required tools pre-installed

FROM ubuntu:22.04

LABEL maintainer="DevOps Team"
LABEL description="Terraform/Atmos development environment with all tools"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Tool versions
ENV TERRAFORM_VERSION=1.16.3
ENV ATMOS_VERSION=1.229.0
ENV AWS_CLI_VERSION=2.36.49
ENV KUBECTL_VERSION=1.37.0
ENV HELM_VERSION=4.3.0
ENV TFLINT_VERSION=0.64.0
ENV CHECKOV_VERSION=3.3.19
ENV INFRACOST_VERSION=0.10.45
ENV PYTHON_VERSION=3.11

# Every download below is verified before use: against the checksum file the
# project publishes with the release (terraform's SHA256SUMS is additionally
# GPG-verified against HashiCorp's pinned key fingerprint), or, for the AWS CLI
# (which publishes only a GPG signature), against the sha256 pinned here.
# AWS_CLI_SHA256 was recorded after verifying the zip's .sig with the AWS CLI
# Team key FB5DB77FD5C118B80511ADA8A6310ACC4672475C; update both together.
ENV HASHICORP_PGP_FINGERPRINT=C874011F0AB405110D02105534365D9472D7468F
ENV AWS_CLI_SHA256=6b51b62d232217350e72d8f2493f47d3461239d011d1d5eef960dfcd8cb07069

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install base packages
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    unzip \
    jq \
    vim \
    nano \
    bash-completion \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    make \
    gcc \
    g++ \
    python3 \
    python3-pip \
    python3-dev \
    groff \
    less \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

# Install Terraform (SHA256SUMS signature checked against the pinned HashiCorp key)
RUN base="https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}" \
    && curl -fsSLO "${base}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
    && curl -fsSLO "${base}/terraform_${TERRAFORM_VERSION}_SHA256SUMS" \
    && curl -fsSLO "${base}/terraform_${TERRAFORM_VERSION}_SHA256SUMS.sig" \
    && curl -fsSL https://www.hashicorp.com/.well-known/pgp-key.txt -o hashicorp.asc \
    && GNUPGHOME="$(mktemp -d)" && export GNUPGHOME \
    && gpg --batch --quiet --import hashicorp.asc \
    && gpg --batch --status-fd 1 --verify "terraform_${TERRAFORM_VERSION}_SHA256SUMS.sig" "terraform_${TERRAFORM_VERSION}_SHA256SUMS" \
       | grep -E "^\[GNUPG:\] VALIDSIG .* ${HASHICORP_PGP_FINGERPRINT}$" \
    && grep "  terraform_${TERRAFORM_VERSION}_linux_amd64.zip$" "terraform_${TERRAFORM_VERSION}_SHA256SUMS" | sha256sum -c - \
    && unzip "terraform_${TERRAFORM_VERSION}_linux_amd64.zip" terraform -d /usr/local/bin \
    && rm -rf "${GNUPGHOME}" /tmp/terraform_* /tmp/hashicorp.asc \
    && terraform --version

# Install Atmos
RUN base="https://github.com/cloudposse/atmos/releases/download/v${ATMOS_VERSION}" \
    && curl -fsSLO "${base}/atmos_${ATMOS_VERSION}_linux_amd64" \
    && curl -fsSLO "${base}/atmos_${ATMOS_VERSION}_SHA256SUMS" \
    && grep "  atmos_${ATMOS_VERSION}_linux_amd64$" "atmos_${ATMOS_VERSION}_SHA256SUMS" | sha256sum -c - \
    && install -m 0755 "atmos_${ATMOS_VERSION}_linux_amd64" /usr/local/bin/atmos \
    && rm -f /tmp/atmos_* \
    && atmos version

# Install AWS CLI v2 (AWS publishes no checksum file; see AWS_CLI_SHA256 above)
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" -o awscliv2.zip \
    && echo "${AWS_CLI_SHA256}  awscliv2.zip" | sha256sum -c - \
    && unzip -q awscliv2.zip \
    && ./aws/install \
    && rm -rf aws awscliv2.zip \
    && aws --version

# Install kubectl
RUN base="https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64" \
    && curl -fsSLO "${base}/kubectl" \
    && echo "$(curl -fsSL "${base}/kubectl.sha256")  kubectl" | sha256sum -c - \
    && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl \
    && rm kubectl \
    && kubectl version --client

# Install Helm
RUN curl -fsSLO "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
    && curl -fsSLO "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz.sha256sum" \
    && sha256sum -c "helm-v${HELM_VERSION}-linux-amd64.tar.gz.sha256sum" \
    && tar -xzf "helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
    && mv linux-amd64/helm /usr/local/bin/helm \
    && rm -rf linux-amd64 helm-v* \
    && helm version

# Install tflint
RUN base="https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}" \
    && curl -fsSLO "${base}/tflint_linux_amd64.zip" \
    && curl -fsSLO "${base}/checksums.txt" \
    && grep "  tflint_linux_amd64.zip$" checksums.txt | sha256sum -c - \
    && unzip tflint_linux_amd64.zip -d /usr/local/bin \
    && rm tflint_linux_amd64.zip checksums.txt \
    && tflint --version

# Install Python tools (top-level packages pinned; Python 3.10 compatible)
RUN pip3 install --no-cache-dir --upgrade pip==26.2.1 setuptools==84.0.0 wheel==0.48.0 && \
    pip3 install --no-cache-dir \
    checkov==${CHECKOV_VERSION} \
    bandit==1.9.4 \
    safety==3.8.1 \
    black==26.5.1 \
    flake8==7.3.0 \
    isort==9.0.1 \
    mypy==2.3.1 \
    pytest==9.1.1 \
    pytest-cov==7.1.0 \
    boto3==1.43.98 \
    awscli-local==0.22.2 \
    pre-commit==4.6.2 \
    pip-audit==2.10.1 \
    detect-secrets==1.5.0

# Install Trivy (security scanner)
RUN wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor -o /usr/share/keyrings/trivy.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main" | tee /etc/apt/sources.list.d/trivy.list \
    && apt-get update \
    && apt-get install -y trivy \
    && rm -rf /var/lib/apt/lists/*

# tfsec is not installed: it is deprecated and Trivy (`trivy config`) covers its checks.

# Install infracost
RUN base="https://github.com/infracost/infracost/releases/download/v${INFRACOST_VERSION}" \
    && curl -fsSLO "${base}/infracost-linux-amd64.tar.gz" \
    && curl -fsSLO "${base}/infracost-linux-amd64.tar.gz.sha256" \
    && sha256sum -c infracost-linux-amd64.tar.gz.sha256 \
    && tar -xzf infracost-linux-amd64.tar.gz \
    && install -m 0755 infracost-linux-amd64 /usr/local/bin/infracost \
    && rm -f infracost-linux-amd64* \
    && infracost --version

# Install shellcheck
RUN apt-get update && apt-get install -y shellcheck && rm -rf /var/lib/apt/lists/*

# Setup workspace
WORKDIR /workspace

# Create user for development
ARG USERNAME=devops
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER $USERNAME

# Setup bash completion
RUN echo 'source /usr/share/bash-completion/bash_completion' >> ~/.bashrc \
    && echo 'complete -C /usr/local/bin/terraform terraform' >> ~/.bashrc \
    && echo 'complete -C /usr/local/bin/aws aws' >> ~/.bashrc

# Add helpful aliases
RUN echo 'alias tf=terraform' >> ~/.bashrc \
    && echo 'alias k=kubectl' >> ~/.bashrc \
    && echo 'alias ll="ls -la"' >> ~/.bashrc

# Set prompt
RUN echo 'export PS1="\[\033[01;32m\]\u@devops\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "' >> ~/.bashrc

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD terraform --version && atmos version && aws --version || exit 1

# Default command
CMD ["/bin/bash"]
