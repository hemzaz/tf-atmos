[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $flavor := .Config.nonprod_flavor -]]
[[- $f := ternary "-dev" "" (eq $flavor "dev") -]]
[[- $net := trimSuffix ".0.0/16" .Config.vpc_cidr_main -]]
[[- $svc := trimSuffix ".0.0/16" .Config.vpc_cidr_services -]]
[[- $transformer_timeout := 600 -]]
---
# =============================================================================
# [[ $stack ]]: the [[ .Config.stage ]] account's [[ .Config.region ]] stack
# =============================================================================
# Generated by `atmos scaffold generate stack` (scaffolds/stack, profile
# nonprod, flavor [[ $flavor ]]). One file per stack: the imports, then one
# vars/settings/components body, grouped by domain (globals, networking,
# security, compute, services).
[[- if eq $flavor "dev" ]]
# Each instance's wiring is catalog/<c>/<i> and, where dev differs, its -dev
# flavor (iam/dev, kms/main-dev, secretsmanager/infra-dev, ec2/app-server-dev,
# monitoring/data-dev, rds/main-dev, rds/data-dev, lambda/data-processor-dev);
# this file keeps the stack's per-stage values. Sizing is fnx-ue1-dev's.
[[- else ]]
# Each instance's wiring is catalog/<c>/<i>, the un-suffixed default; this
# flavor adds lambda/data-transformer and its queue sqs/data-transform. This
# file keeps the stack's per-stage values. Sizing is fnx-ue1-staging's.
[[- end ]]
# =============================================================================

import:
  - catalog/_base/defaults
  # Region mixin: region [[ .Config.region ]], environment (region code) [[ .Config.region_code ]]
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults

  # --- globals: shared catalog defaults (the rest come with their instances)
  - catalog/vpc/defaults
  - catalog/network/defaults
  - catalog/secretsmanager/defaults
  - catalog/external-secrets/defaults
  - catalog/ec2/defaults
  - catalog/eks/defaults
  - catalog/iam/defaults
  - catalog/acm/defaults
  - catalog/apigateway/defaults
  - catalog/monitoring/defaults

  # --- networking
  - catalog/vpc/main
  - catalog/vpc/services
  - catalog/network/vpc-peering
  - catalog/network/main
  - catalog/network/services

  # --- security
  - catalog/iam/[[ if eq $flavor "dev" ]]dev[[ else ]]main[[ end ]]
  - catalog/iam/ci
  - catalog/kms/main[[ $f ]]
  - catalog/secretsmanager/app
  - catalog/secretsmanager/infra[[ $f ]]
  - catalog/acm/main
  - catalog/acm/services
  - catalog/cloudtrail/main
  - catalog/awsconfig/main
  - catalog/guardduty/main
  - catalog/securityhub/main
  - catalog/inspector2/main
  - catalog/apigateway-account/main
  - catalog/security-monitoring/main
  - catalog/backup/main

  # --- compute
  - catalog/eks/main
  - catalog/eks/data
  - catalog/github-runners/main
  - catalog/ec2/bastion
  - catalog/ec2/app-server[[ $f ]]
  - catalog/external-secrets/main
  - catalog/external-secrets/data
  - catalog/eks-addons/main
  - catalog/eks-addons/data
  - catalog/eks-backend-services/main

  # --- services
  - catalog/apigateway/main
  - catalog/apigateway/data
  - catalog/cognito/main
  - catalog/monitoring/main
  - catalog/monitoring/data[[ $f ]]
  - catalog/s3/lambda-artifacts
[[- if ne $flavor "dev" ]]
  - catalog/sqs/data-transform
[[- end ]]
  - catalog/cost-optimization/main
  - catalog/rds/main[[ $f ]]
  - catalog/rds/data[[ $f ]]
  - catalog/ecs/main
  - catalog/lambda/data-processor[[ $f ]]
[[- if ne $flavor "dev" ]]
  - catalog/lambda/data-transformer
[[- end ]]

vars:
  region: [[ .Config.region ]]
  tags:
[[- if eq $flavor "dev" ]]
    Team: "DevOps"
    CostCenter: "IT"
    Project: "Infrastructure"
    ManagedBy: "Terraform"
    Tenant: "[[ .Config.tenant ]]"
    Application: "Testing"
    Provisioner: "Atmos"
[[- else ]]
    Team: "Platform"
    CostCenter: "[[ title .Config.stage ]]"
    Project: "Infrastructure"
    ManagedBy: "Terraform"
    Tenant: "[[ .Config.tenant ]]"
    Application: "[[ title .Config.stage ]]"
    Provisioner: "Atmos"
    DataClassification: "internal"
[[- end ]]

settings:
  context:
    tenant: [[ .Config.tenant ]]
    stage: [[ .Config.stage ]]
  # Environment metadata (not passed to Terraform); component templates read
  # it as {{ .settings.environment.<key> }}.
  environment:
    account: [[ .Config.stage ]]
    # The stack's one domain. Every dns zone/record, acm domain/SAN and
    # apigateway custom domain derives from it; the Route 53 zone ids come from
    # the dns instances' zone_ids output, never from settings.
    domain_name: "[[ .Config.domain_name ]]"
    monitoring:
      critical_alerts:
[[- range splitList "," .Config.critical_alerts ]]
        - "[[ . ]]"
[[- end ]]
      warning_alerts:
[[- range splitList "," .Config.warning_alerts ]]
        - "[[ . ]]"
[[- end ]]
      # cost-optimization/main's monthly AWS Budget (numeric string - see
      # components/terraform/cost-optimization/variables.tf).
      budget_monthly_limit: "[[ .Config.budget_monthly_limit ]]"
    eks_kubernetes_version: "1.36"
    eks_public_access: false
    rds_engine: "postgres"
    rds_engine_version: "14"
    use_external_secrets: true
    # eks-backend-services/main's images. Release-pipeline-owned: these
    # repositories/tags are not built by this repo. Terraform requires each
    # value to be repository:tag or repository@sha256:<digest>, never :latest
    # (variable validation).
    backend_service_images:
      api_gateway: "ghcr.io/fnx-platform/api-gateway:1.4.2"
      platform_api: "ghcr.io/fnx-platform/platform-api:1.4.2"
      auth_service: "ghcr.io/fnx-platform/auth-service:1.4.2"
      job_processor: "ghcr.io/fnx-platform/job-processor:1.4.2"
    enable_vpc_flow_logs: [[ ne $flavor "dev" ]]

  # The two VPCs' CIDRs, in one place: each vpc instance's
  # ipv4_primary_cidr_block, the other one's
  # private_network_acl_peer_cidr_blocks and network/vpc-peering's routes all
  # read them. Literals, not !terraform.state <vpc> .vpc_cidr: vpc/main and
  # vpc/services would then read each other, a cycle.
[[- if ne $flavor "dev" ]]
  # database_subnet_cidrs.main is vpc/main's database_subnets, which
  # ec2/app-server's PostgreSQL egress also reads.
[[- end ]]
  network:
    vpc_cidrs:
      main: "[[ .Config.vpc_cidr_main ]]"
      services: "[[ .Config.vpc_cidr_services ]]"
[[- if ne $flavor "dev" ]]
    database_subnet_cidrs:
      main:
        - "[[ $net ]].201.0/24"
        - "[[ $net ]].202.0/24"
        - "[[ $net ]].203.0/24"
[[- end ]]

components:
  terraform:
    # ========================================================================
    # Globals
    # ========================================================================
    # Human cluster admins of every eks instance in this stack (eks/main and
    # eks/data inherit eks/defaults): Cloud Posse's map_additional_iam_roles
    # (components/terraform/eks/variables.tf); groups ["system:masters"] is a
    # cluster-scoped AmazonEKSClusterAdminPolicy access entry. They apply the
    # in-cluster components through the bastion's SSM port-forward
    # (docs/OPERATIONS.md, "In-cluster components"), so
    # each rolearn must also be in backend/main's
    # access_roles.write allowed_principal_arns
    # (stacks/orgs/fnx/root/us-east-1.yaml). check-cluster-api-ci.py fails
    # a role listed here but not there, and warns while this list is empty.
    # The full role ARN WITH its path, e.g. IAM Identity Center's:
    #   - rolearn: "arn:aws:iam::<account>:role/aws-reserved/sso.amazonaws.com/<sso-region>/AWSReservedSSO_AdministratorAccess_<hash>"
    #     groups: ["system:masters"]
    # Empty until the owner supplies the real ARN: an access entry for a role
    # that does not exist fails eks/main's apply.
    eks/defaults:
      vars:
        map_additional_iam_roles: []

    # ========================================================================
    # Networking: VPCs and DNS. Wiring is catalog/vpc/<i> and
    # catalog/network/<i>; this file keeps the CIDRs, AZs, subnets and
    # per-stage values. Subnets are cut from each /16: private x.y.1-3,
    # public x.y.101-103[[ if ne $flavor "dev" ]], database (vpc/main) x.y.201-203[[ end ]].
    # ========================================================================
    vpc/main:
      vars:
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $net ]].1.0/24"
          - "[[ $net ]].2.0/24"
          - "[[ $net ]].3.0/24"
        public_subnets:
          - "[[ $net ]].101.0/24"
          - "[[ $net ]].102.0/24"
          - "[[ $net ]].103.0/24"
[[- if eq $flavor "dev" ]]
        vpc_flow_logs_enabled: "{{ .settings.environment.enable_vpc_flow_logs }}"
[[- else ]]
        # One element per AZ, from settings.network.database_subnet_cidrs.main;
        # the first element fails the render unless the list has exactly 3.
        database_subnets:
          - '{{ if ne (len .settings.network.database_subnet_cidrs.main) 3 }}{{ fail "settings.network.database_subnet_cidrs.main needs exactly 3 entries, one per AZ" }}{{ end }}{{ index .settings.network.database_subnet_cidrs.main 0 }}'
          - "{{ index .settings.network.database_subnet_cidrs.main 1 }}"
          - "{{ index .settings.network.database_subnet_cidrs.main 2 }}"
        tags:
          NetworkTier: "primary"
        vpc_flow_logs_enabled: true
[[- end ]]
    vpc/services:
      vars:
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $svc ]].1.0/24"
          - "[[ $svc ]].2.0/24"
          - "[[ $svc ]].3.0/24"
        public_subnets:
          - "[[ $svc ]].101.0/24"
          - "[[ $svc ]].102.0/24"
          - "[[ $svc ]].103.0/24"
[[- if eq $flavor "dev" ]]
        vpc_flow_logs_enabled: "{{ .settings.environment.enable_vpc_flow_logs }}"
[[- else ]]
        tags:
          NetworkTier: "services"
        vpc_flow_logs_enabled: true
[[- end ]]

    network/main:
      vars:
        zones:
          main:
            comment: "Main zone for [[ if eq $flavor "dev" ]][[ .Config.tenant ]][[ else ]][[ .Config.stage ]][[ end ]] environment"
          internal:
            comment: "Internal DNS for [[ if eq $flavor "dev" ]][[ .Config.tenant ]] environment[[ else ]][[ .Config.stage ]][[ end ]]"
        records:
          www_main:
            records: ["[[ $net ]].101.100"]
[[- if eq $flavor "dev" ]]
          db_internal:
            records: ["[[ $net ]].1.50"]
[[- else ]]
          # A literal: it must stay inside
          # settings.network.database_subnet_cidrs.main[0].
          db_internal:
            records: ["[[ $net ]].201.50"]
[[- end ]]

    network/services:
      vars:
        zones:
          services:
            comment: "Services zone for [[ if eq $flavor "dev" ]][[ .Config.tenant ]] environment[[ else ]][[ .Config.stage ]][[ end ]]"
          data:
            comment: "Data services DNS[[ if eq $flavor "dev" ]] zone[[ end ]]"

    # ========================================================================
    # Security
    # ========================================================================
[[- if eq .Config.account_singletons "no" ]]
    # The account's singletons belong to its other stack (the guard checked
    # there is one): this stack's iam/ci trusts that stack's GitHub OIDC
    # provider instead of creating one, and its iam instance leaves the Auto
    # Scaling service-linked role alone, as the prod standbys' -standby files
    # do. Its trail records this region only (that stack's trail is
    # multi-region and records the global services) and awsconfig/main
    # records no global resources (IAM), as awsconfig/main-standby does.
    # check-lane-names.py allows each singleton once per account.
    iam/ci:
      vars:
        github_oidc_create_provider: false
        github_oidc_provider_arn: "arn:aws:iam::{{ .settings.environment.account_id }}:oidc-provider/token.actions.githubusercontent.com"
    iam/[[ if eq $flavor "dev" ]]dev[[ else ]]main[[ end ]]:
      vars:
        enable_autoscaling_service_linked_role: false
    # Deliberate: this regional trail is a second, billed copy of this
    # region's management events (the other stack's multi-region trail
    # already delivers them), kept so security-monitoring/main's CIS metric
    # filters run on a trail in this region.
    cloudtrail/main:
      vars:
        is_multi_region_trail: false
        include_global_service_events: false
    awsconfig/main:
      vars:
        include_global_resource_types: false
[[ end ]]
    # KMS - customer-managed key for Secrets Manager and other encrypted
    # services
    kms/main:
      vars:
        description: [[ title .Config.stage ]] main encryption key (Secrets Manager, EBS, RDS)
[[- if ne $flavor "dev" ]]

    acm/services:
      vars:
        dns_domains:
          services_wildcard:
            subject_alternative_names:
              - "api.services.{{ .settings.environment.domain_name }}"
[[- end ]]

    # Secrets Manager instances
    secretsmanager/app:
      vars:
        secrets:
[[- if eq $flavor "dev" ]]
          app_credentials:
            name: "credentials"
            description: "Application credentials"
            path: "app"
            generate_random_password: true
          app_keys:
            name: "api-keys"
            description: "API integration keys"
            path: "app/api"
            generate_random_password: true

    secretsmanager/infra:
      vars:
        secrets:
          istio_certificates:
            name: "istio-certificates"
            description: "TLS certificates for Istio Gateway"
            path: "certificates"
            # The value comes from the ephemeral secret_data variable (env,
            # catalog/secretsmanager/infra-dev.yaml), written write-only:
            # never in plan or state.
            static_value: true

    # AWS Backup - short retention.
    backup/main:
      vars:
        daily_retention_days: 7
        weekly_retention_days: 14
        monthly_retention_days: 30
[[- else ]]
          app_credentials:
            name: "credentials"
            description: "Application credentials for [[ .Config.stage ]]"
            path: "app"
            generate_random_password: true
            password_length: 32
          api_keys:
            name: "api-keys"
            description: "API integration keys for [[ .Config.stage ]]"
            path: "app/api"
            generate_random_password: true
          database_credentials:
            name: "db-credentials"
            description: "Database connection credentials"
            path: "app/database"
            generate_random_password: true
            password_length: 24
        default_recovery_window_in_days: 7

    secretsmanager/infra:
      vars:
        secrets:
          tls_certificates:
            name: "tls-certificates"
            description: "TLS certificates for services"
            path: "certificates"
          ssh_keys:
            name: "ssh-keys"
            description: "SSH keys for infrastructure access"
            path: "ssh"
        default_recovery_window_in_days: 7

    # AWS Backup - medium retention.
    backup/main:
      vars:
        daily_retention_days: 14
        weekly_retention_days: 30
        monthly_retention_days: 90
[[- end ]]

    # ========================================================================
    # Compute[[ if eq $flavor "dev" ]]. ec2/app-server is import-only: catalog/ec2/app-server-dev[[ end ]]
    # ========================================================================
[[- if eq $flavor "dev" ]]
    eks/main:
      vars:
        cluster_endpoint_public_access: "{{ .settings.environment.eks_public_access }}"
        node_groups:
          workers:
            desired_group_size: 2
            min_group_size: 1
            max_group_size: 4
    eks/data:
      vars:
        node_groups:
          data-workers:
            instance_types: ["m5.large"]
            desired_group_size: 2
            min_group_size: 2
            max_group_size: 4
            kubernetes_labels:
              role: data

    ec2/bastion:
      vars:
        allowed_ingress_rules:
          - from_port: 22
            to_port: 22
            protocol: "tcp"
            # fnx-ue1-dev's literal, whatever this stack's own CIDR (the
            # golden pins it). A literal for now (owner decision); it becomes
            # an input once a real VPN range exists.
            cidr_blocks: ["10.0.0.0/8"]
            description: "SSH from internal networks"
        allowed_egress_rules:
          - from_port: 443
            to_port: 443
            protocol: "tcp"
            cidr_blocks: ["0.0.0.0/0"]
            description: "HTTPS outbound access"

    external-secrets/main:
      vars:
        enabled: "{{ .settings.environment.use_external_secrets }}"
    external-secrets/data:
      vars:
        enabled: "{{ .settings.environment.use_external_secrets }}"

    # EKS add-ons: Let's Encrypt's staging ACME server.
    eks-addons/main:
      vars:
        clusters:
          main:
            cert_manager_acme_server: "https://acme-staging-v02.api.letsencrypt.org/directory"
    eks-addons/data:
      vars:
        clusters:
          data:
            container_insights_log_retention_days: 7
            cert_manager_acme_server: "https://acme-staging-v02.api.letsencrypt.org/directory"
[[- else ]]
    eks/main:
      vars:
        tags:
          Cluster: main
          Purpose: "application-workloads"
        # Endpoint access - private only
        cluster_endpoint_public_access: false
        enabled_cluster_log_types:
          - "api"
          - "audit"
          - "authenticator"
          - "controllerManager"
          - "scheduler"
        node_groups:
          workers:
            desired_group_size: 3
            min_group_size: 2
            max_group_size: 6
            kubernetes_labels:
              environment: "{{ .settings.context.stage }}"
            tags:
              NodeGroup: workers

    eks/data:
      vars:
        tags:
          Cluster: data
          Purpose: "data-processing"
        enabled_cluster_log_types:
          - "api"
          - "audit"
        node_groups:
          data-workers:
            instance_types: ["m5.large"]
            desired_group_size: 2
            min_group_size: 2
            max_group_size: 4
            kubernetes_labels:
              role: data-processing
            block_device_map:
              "/dev/xvda":
                ebs:
                  volume_size: 100

    ec2/bastion:
      vars:
        tags:
          Role: bastion
          Access: restricted
        ebs_optimized: true
        allowed_ingress_rules:
          - from_port: 22
            to_port: 22
            protocol: "tcp"
            cidr_blocks: ["10.0.0.0/8"]
            description: "SSH from internal networks"
        allowed_egress_rules:
          - from_port: 443
            to_port: 443
            protocol: "tcp"
            cidr_blocks: ["0.0.0.0/0"]
            description: "HTTPS outbound"
          - from_port: 22
            to_port: 22
            protocol: "tcp"
            cidr_blocks: ["10.0.0.0/8"]
            description: "SSH to internal hosts"
        monitoring: true
        root_volume_type: "gp3"
        root_volume_size: 20
        root_block_device_encrypted: true
        delete_on_termination: true

    external-secrets/main:
      vars:
        enabled: true
    external-secrets/data:
      vars:
        enabled: true

    eks-addons/data:
      vars:
        clusters:
          data:
            container_insights_log_retention_days: 7
[[- end ]]

    # ========================================================================
    # Services[[ if eq $flavor "dev" ]]. rds/main, rds/data, lambda/data-processor and monitoring/data
    # are import-only (their -dev flavors)[[ end ]]
    # ========================================================================
[[- if eq $flavor "dev" ]]
    cognito/main:
      vars:
        # A deletable pool, so tearing the environment down does not leave one
        # behind.
        deletion_protection: false

    apigateway/main:
      vars:
        description: "Main API Gateway for {{ .settings.context.tenant }}-{{ .settings.prefix }}"
        api_resources:
          - path_part: "api"
          - path_part: "auth"
        log_retention_days: 30

    apigateway/data:
      vars:
        api_name: "data-api"
        description: "Data API Gateway for {{ .settings.context.tenant }}-{{ .settings.prefix }}"
        api_resources:
          - path_part: "data"
          - path_part: "metrics"
        log_retention_days: 30

    ecs/main:
      vars:
        cluster_name: "main-apps"

    monitoring/main:
      vars:
        # Alert emails
        alarm_email_subscriptions:
          - "{{ index .settings.environment.monitoring.critical_alerts 0 }}"
          - "{{ index .settings.environment.monitoring.warning_alerts 0 }}"
[[- else ]]
    apigateway/main:
      vars:
        description: "Main API Gateway for [[ .Config.stage ]] environment"
        api_resources:
          - path_part: "api"
          - path_part: "auth"
          - path_part: "health"
        throttling_burst_limit: 500
        throttling_rate_limit: 1000
        log_retention_days: 14
        tags:
          Service: api-gateway
          Tier: edge
        cors_configuration:
          allow_origins: ["*"]
          allow_methods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
          allow_headers:
            - '*'
          expose_headers: []
          max_age: 300
          allow_credentials: false

    apigateway/data:
      vars:
        api_name: "data-api"
        description: "Data API Gateway for [[ .Config.stage ]]"
        api_resources:
          - path_part: "data"
          - path_part: "metrics"
          - path_part: "analytics"
        throttling_burst_limit: 300
        throttling_rate_limit: 500
        log_retention_days: 14
        tags:
          Service: data-api
          Tier: backend

    ecs/main:
      vars:
        cluster_name: "{{ .settings.context.stage }}-main-apps"
        enable_container_insights: true

    lambda/data-processor:
      vars:
        memory_size: 512
        timeout: 300

    # sqs/data-transform's visibility_timeout_seconds is derived from this
    # timeout: change them together.
    lambda/data-transformer:
      vars:
        memory_size: 1024
        timeout: [[ $transformer_timeout ]]

    sqs/data-transform:
      vars:
        # AWS: at least 6x the consumer's timeout plus its batching window,
        # 6 x [[ $transformer_timeout ]] (lambda/data-transformer timeout) + 5 = [[ add 5 (mul 6 $transformer_timeout) ]].
        visibility_timeout_seconds: [[ add 5 (mul 6 $transformer_timeout) ]]

    monitoring/main:
      vars:
        # eks/main's node_groups (compute section): workers (min_group_size 2)
        # + monitoring (min_group_size 1) = 3 guaranteed nodes. The
        # eks_node_count_low alarm (monitoring's alarms.tf) only fires below
        # this floor.
        eks_min_node_count: 3

        # SNS Topics for alerts
        alarm_email_subscriptions:
[[- range splitList "," .Config.alarm_emails ]]
          - "[[ . ]]"
[[- end ]]

        # CloudWatch Alarms
        cpu_alarms:
          high_cpu:
            namespace: "AWS/EC2"
            evaluation_periods: 2
            period: 300
            threshold: 80
            dimensions: {}
        memory_alarms:
          high_memory:
            namespace: "CWAgent"
            evaluation_periods: 2
            period: 300
            threshold: 85
            dimensions: {}

    monitoring/data:
      vars:
        alarm_email_subscriptions:
          - "[[ index (splitList "," .Config.critical_alerts) 0 ]]"
[[- end ]]
