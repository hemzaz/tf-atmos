[[- $account := default .Config.stage .Config.account -]]
[[- $gdpr := eq $account "prod-eu" -]]
[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $primary := .Config.standby_of -]]
[[- $primary_code := index (splitList "-" $primary) 1 -]]
[[- $net := trimSuffix ".0.0/16" .Config.vpc_cidr_main -]]
---
# =============================================================================
# [[ $stack ]]: the [[ $account ]] account's [[ .Config.region ]] stack,
# the DR warm standby of [[ $primary ]]
# =============================================================================
# DR is prod only (owner decision Q5, 2026-10-03): a warm standby whose
# failover is real infrastructure. Same account as [[ $primary ]], so its names
# carry the [[ .Config.region_code ]] prefix (settings.prefix) and the account's singletons stay in
# [[ $primary ]]: the GitHub OIDC provider, the Auto Scaling service-linked role,
# the multi-region CloudTrail trail, AWS Config's global-resource recording,
# the account budget and the cross-account role. What "warm" means per
# component is in docs/OPERATIONS.md ("Disaster recovery"):
#   - networking, CI roles, regional security services: full, as in the primary;
#   - KMS: [[ $primary ]] kms/main's multi-region replica (alias [[ .Config.region_code ]]-main);
#   - rds/main: a cross-region read replica of the primary's, promoted on
#     failover; elasticache/main: a Global Datastore secondary;
#   - eks/main: the same node groups at their minimum; the in-cluster services
#     are deployed on failover;
#   - apigateway/main: the SECONDARY half of api.<domain>'s failover pair,
#     authorized by this region's cognito/main;
#   - cognito/main: its own pool (AWS has no cross-region user pools), filled
#     from the primary's by a user-migration trigger
#     (lambda/cognito-user-migration);
#   - monitoring/main: this region's [[ .Config.region_code ]]-main-alarms topic and alarms.
# Not replicated: rds/data and the data VPC (restored from backup/main's
# copies in [[ .Config.region ]]).
[[- if $gdpr ]]
#
# GDPR-scoped (account prod-eu): EU personal data never leaves the EU. Tagged
# Compliance "pci-sox-gdpr" (vars.tags below); check-data-residency.py fails
# it if it names a non-EU region or depends on a US stack. Its state is in the
# EU backend, fnx-ew1-root's backend/main (stacks/orgs/fnx/root/eu-west-1.yaml).
[[- end ]]
#
# Same tags, domain and contacts as [[ $primary ]]: one production service,
# two regions.
#
# Generated by `atmos scaffold generate stack` (scaffolds/stack, profile
# standby). One file per stack: the imports, then one vars/settings/components
# body, grouped by domain (globals, networking, security, compute, services).
# Every instance's wiring is the catalog's -standby files
# (settings.dr.standby_of names [[ $primary ]]), plus the plain inspector2/main
# and apigateway-account/main files every dev, staging and prod stack imports;
# each domain section below says what this file keeps.
# =============================================================================

import:
  - catalog/_base/defaults
  # Region mixin: region [[ .Config.region ]], environment (region code) [[ .Config.region_code ]]
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults

  # --- globals: shared catalog defaults (the rest come with their instances)
[[- if $gdpr ]]
  - catalog/iam/defaults
  - catalog/vpc/defaults
  - catalog/eks/defaults
[[- else ]]
  - catalog/vpc/defaults
  - catalog/eks/defaults
  - catalog/iam/defaults
  - catalog/acm/defaults
  - catalog/apigateway/defaults
  - catalog/monitoring/defaults
[[- end ]]

  # --- networking
  - catalog/vpc/main-standby

  # --- security
  - catalog/iam/ci-standby
  - catalog/acm/main-standby
  - catalog/awsconfig/main-standby
  - catalog/guardduty/main-standby
  - catalog/securityhub/main-standby
  - catalog/security-monitoring/main-standby
  - catalog/backup/main-standby
  - catalog/inspector2/main
  - catalog/apigateway-account/main

  # --- compute
  - catalog/eks/main-standby
  - catalog/github-runners/main-standby
  - catalog/ec2/bastion-standby
  - catalog/external-secrets/main-standby
  - catalog/eks-addons/main-standby
  - catalog/eks-backend-services/main-standby

  # --- services
  - catalog/rds/main-standby
  - catalog/elasticache/main-standby
  - catalog/cognito/main-standby
  - catalog/lambda/cognito-user-migration-standby
  - catalog/apigateway/main-standby
  - catalog/monitoring/main-standby

vars:
  region: [[ .Config.region ]]
  tags:
    Team: "Platform"
    CostCenter: "Production"
    Project: "Infrastructure"
    ManagedBy: "Terraform"
    Tenant: "[[ .Config.tenant ]]"
    Application: "Production"
    Provisioner: "Atmos"
    DataClassification: "confidential"
    Compliance: "[[ if $gdpr ]]pci-sox-gdpr[[ else ]]pci-sox[[ end ]]"
    CriticalityLevel: "high"
    SLA: "99.9"
    BackupRequired: "true"
    DisasterRecovery: "warm-standby"

settings:
  # DR standby of [[ $primary ]], whose state it reads: CD deploys it right after
  # that stack, whatever the names (workflows/scripts/common/ci-stacks.py).
  dr:
    standby_of: [[ $primary ]]
  context:
    tenant: [[ .Config.tenant ]]
    stage: [[ .Config.stage ]]
  environment:
    account: [[ $account ]]
    # The production domain: api.<domain> fails over to this stack. Its zone is
    # [[ $primary ]]'s network/main (Route 53 has no region).
    domain_name: "[[ .Config.domain_name ]]"
    monitoring:
      critical_alerts:
[[- range splitList "," .Config.critical_alerts ]]
        - "[[ . ]]"
[[- end ]]
      warning_alerts:
[[- range splitList "," .Config.warning_alerts ]]
        - "[[ . ]]"
[[- end ]]
    eks_kubernetes_version: "1.36"
    eks_public_access: false
    rds_engine: "postgres"
    rds_engine_version: "14"
    use_external_secrets: true
    # The release pipeline's images, as in [[ $primary ]]: a failover deploys
    # the same release.
    backend_service_images:
      api_gateway: "ghcr.io/fnx-platform/api-gateway:1.4.2"
      platform_api: "ghcr.io/fnx-platform/platform-api:1.4.2"
      auth_service: "ghcr.io/fnx-platform/auth-service:1.4.2"
      job_processor: "ghcr.io/fnx-platform/job-processor:1.4.2"
    enable_vpc_flow_logs: true
[[- if $gdpr ]]
  # The EU backend (overriding every settings.tfstate key, literal
  # .settings.context.* references only, see stacks/orgs/fnx/_defaults.yaml):
  # the state stays in eu-west-1 whatever this stack's region, replicated to
  # eu-central-1.
  tfstate:
    region: eu-west-1
    replica_region: eu-central-1
    bucket: '{{ .settings.context.tenant }}-ew1-terraform-state'
    role_prefix: '{{ .settings.context.tenant }}-ew1-terraform-backend'
    stack: '{{ .settings.context.tenant }}-ew1-root'
[[- end ]]
  network:
    vpc_cidrs:
      main: "[[ .Config.vpc_cidr_main ]]"

components:
  terraform:
    # ========================================================================
    # Globals
    # ========================================================================
    # Human cluster admins of eks/main, as in [[ $primary ]]: the same
    # operators fail the in-cluster services over. Each rolearn must also be in
    # the state backend's access_roles.prod_write. Empty until the owner
    # supplies the ARN.
    eks/defaults:
      vars:
        map_additional_iam_roles: []

    # ========================================================================
    # Networking
    #
    # Warm = full: vpc/main as in [[ $primary ]] (three AZs, a NAT gateway per
    # AZ, flow logs), on its own CIDR so the two regions can be peered later
    # without renumbering. No vpc/services: the data tier is restored from
    # backup copies, not run warm. No dns instance: the public zone is
    # [[ $primary ]]'s network/main. This file keeps vpc/main's CIDR, AZs and
    # subnets.
    # ========================================================================
    vpc/main:
      vars:
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $net ]].1.0/24"
          - "[[ $net ]].2.0/24"
          - "[[ $net ]].3.0/24"
        public_subnets:
          - "[[ $net ]].101.0/24"
          - "[[ $net ]].102.0/24"
          - "[[ $net ]].103.0/24"
        database_subnets:
          - "[[ $net ]].201.0/24"
          - "[[ $net ]].202.0/24"
          - "[[ $net ]].203.0/24"

    # ========================================================================
    # Security
    #
    # Regional services run here as in [[ $primary ]] (GuardDuty, Security Hub,
    # AWS Config, Inspector, finding routing, backups); account-wide ones do
    # not: no kms/main (this region's key is [[ $primary ]] kms/main's
    # multi-region replica, alias [[ .Config.region_code ]]-main), no iam/main, no cloudtrail/main
    # (the primary's trail is multi-region), and awsconfig/main records this
    # region's resources only. iam/ci trusts the account's GitHub OIDC
    # provider, created by [[ $primary ]]'s iam/ci.
    #
    # This file keeps security-monitoring/main's alert settings.
    # ========================================================================
    security-monitoring/main:
      vars:
[[- if $gdpr ]]
        # Off in a GDPR-scoped stack (check-data-residency.py).
[[- end ]]
        enable_alert_enrichment: false
        security_email_subscriptions: []

    # ========================================================================
    # Compute (imports only: the instances come whole from the -standby files)
    #
    # Warm = the same cluster shape as [[ $primary ]]'s eks/main at its floor;
    # failover scales the node groups (docs/OPERATIONS.md, "Disaster
    # recovery"). Failover step 6 switches this file's eks-backend-services
    # import to main-standby-failover and sets database_secret_arn here, never
    # in the shared files.
    # ========================================================================

    # ========================================================================
    # Services
    #
    # The data tier the serving path fails over to, kept in sync continuously:
    # rds/main (a cross-region read replica of [[ $primary ]]'s; once promoted,
    # this file's import catalog/rds/main-standby switches to
    # catalog/rds/main-standby-promoted), elasticache/main (a Global Datastore
    # secondary), apigateway/main (the SECONDARY half of api.<domain>'s Route
    # 53 failover pair), cognito/main (this region's own user pool, filled by
    # lambda/cognito-user-migration) and monitoring/main.
    #
    # This file keeps apigateway/main's health check alarm target.
    # ========================================================================
    apigateway/main:
      vars:
[[- if $gdpr ]]
        # The checkers: eu-west-1, the only EU checker region, plus two others
        # (Route 53 needs three): probes of the API's stage root, a residency
        # exemption (check-data-residency.py EXEMPTIONS).
        health_check_regions: ["eu-west-1", "us-east-1", "ap-southeast-1"]
        # The health check's alarm is in us-east-1 (Route 53's metrics are only
        # there) and notifies nothing there: EventBridge relays its state
        # changes to the default bus of both EU regions, where each
        # monitoring/main delivers them to its topic. Owner decision B5.
        health_check_alarm_relay_regions: ["[[ .Config.primary_region ]]", "[[ .Config.region ]]"]

    monitoring/main:
      vars:
        # Delivers the relayed us-east-1 health check alarms of the EU failover
        # pair (both apigateway/main halves) to [[ .Config.region_code ]]-main-alarms.
        receive_relayed_health_check_alarms: true
[[- else ]]
        # The health check's alarm is in us-east-1 (Route 53's metrics are only
        # there), so it notifies [[ $primary ]] monitoring/main's topic, which is
        # there too.
        health_check_alarm_actions:
          - "arn:aws:sns:us-east-1:{{ .settings.environment.account_id }}:[[ $primary_code ]]-main-alarms"
[[- end ]]
