[[- $account := default .Config.stage .Config.account -]]
[[- $gdpr := eq $account "prod-eu" -]]
[[- $data_plane := eq .Config.data_plane "yes" -]]
[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $standby := printf "%s-%s-%s" .Config.tenant .Config.dr_region_code .Config.stage -]]
[[- $net := trimSuffix ".0.0/16" .Config.vpc_cidr_main -]]
[[- $svc := trimSuffix ".0.0/16" (default "" .Config.vpc_cidr_services) -]]
[[- $transformer_timeout := 900 -]]
[[- /* The guard's pairing, also under --skip-hooks: the data plane runs in the
prod account's primary only, the prod-eu account's EU primary has none (owner
decision B5); no reference stack pins the other two combinations. */ -]]
[[- if ne $data_plane (not $gdpr) ]][[ fail "prod-primary: data_plane=yes is the prod account's primary only, data_plane=no the prod-eu account's only" ]][[ end -]]
---
# =============================================================================
# [[ $stack ]]: the [[ $account ]] account's prod primary, [[ .Config.region ]]
# =============================================================================
# The account's primary prod stack. Its DR warm standby is [[ $standby ]]
# (settings.dr.region [[ .Config.dr_region ]]), in the same account.
[[- if $gdpr ]]
#
# GDPR-scoped (account prod-eu, owner decision B5): EU personal data lives
# only in EU stacks. Tagged Compliance "pci-sox-gdpr" (vars.tags below);
# check-data-residency.py fails it if it names a non-EU region or depends on
# a US stack. Its state is in the EU backend, fnx-ew1-root's backend/main
# (stacks/orgs/fnx/root/eu-west-1.yaml), through its prod_read/prod_write
# roles.
[[- end ]]
[[- if $data_plane ]]
#
# It runs the data plane: the services VPC (vpc/services, peered with
# vpc/main), the data cluster eks/data, the analytics database rds/data, the
# ECS cluster, the data API and its Lambda functions and queue.
# ALL CHANGES REQUIRE CHANGE MANAGEMENT APPROVAL.
[[- end ]]
#
# It owns the account's singletons: the GitHub OIDC provider (iam/ci), the
# Auto Scaling service-linked role (iam/main), the multi-region CloudTrail
# trail, AWS Config's global-resource recording and the account budget
# (cost-optimization/main, which also counts [[ $standby ]]).
#
# First deploy: docs/OPERATIONS.md ("Deploying a stack"), with
# administrator credentials in the [[ $account ]] account:
#   atmos workflow full -f bootstrap -s [[ $stack ]]
#
# Generated by `atmos scaffold generate stack` (scaffolds/stack, profile
# prod-primary[[ if $data_plane ]], data plane: fnx-ue1-prod's[[ else ]], no data plane: fnx-ew1-prod's core subset[[ end ]]). One file per
# stack: the imports, then one vars/settings/components body, grouped by
# domain (globals, networking, security, compute, services). Every
# instance's wiring is its catalog/<component>/<instance> file: a prod
# flavor (-prod, -prod-data-plane[[ if $gdpr ]], -prod-eu for the prod-eu account's
# budget[[ end ]]) where a prod primary differs, else the un-suffixed default;
# each domain section below says what this file keeps.
# =============================================================================

import:
  - catalog/_base/defaults
  # Region mixin: region [[ .Config.region ]], environment (region code) [[ .Config.region_code ]]
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults

  # --- globals: catalog defaults (the rest come with their instances)
[[- if $data_plane ]]
  - catalog/vpc/defaults
  - catalog/network/defaults
  - catalog/secretsmanager/defaults
  - catalog/external-secrets/defaults
  - catalog/ec2/defaults
  - catalog/eks/defaults
  - catalog/iam/defaults
  - catalog/acm/defaults
  - catalog/apigateway/defaults
  - catalog/monitoring/defaults
[[- else ]]
  - catalog/iam/defaults
  - catalog/vpc/defaults
  - catalog/network/defaults
  - catalog/eks/defaults
[[- end ]]

  # --- networking
[[- if $data_plane ]]
  - catalog/vpc/main-prod
  - catalog/vpc/services-prod
  - catalog/network/vpc-peering
  - catalog/network/main-prod-data-plane
  - catalog/network/services-prod
[[- else ]]
  - catalog/vpc/main-prod
  - catalog/network/main-prod
[[- end ]]

  # --- security
[[- if $data_plane ]]
  - catalog/iam/main-prod
  - catalog/iam/ci-prod
  - catalog/kms/main-prod
  - catalog/secretsmanager/app-prod
  - catalog/secretsmanager/infra-prod
  - catalog/acm/main-prod
  - catalog/acm/services
  - catalog/cloudtrail/main
  - catalog/awsconfig/main
  - catalog/guardduty/main-prod
  - catalog/securityhub/main-prod
  - catalog/inspector2/main
  - catalog/apigateway-account/main
  - catalog/security-monitoring/main
  - catalog/backup/main-prod
[[- else ]]
  - catalog/iam/main-prod
  - catalog/iam/ci-prod
  - catalog/kms/main-prod
  - catalog/cloudtrail/main
  - catalog/awsconfig/main
  - catalog/guardduty/main-prod
  - catalog/securityhub/main-prod
  - catalog/inspector2/main
  - catalog/security-monitoring/main
  - catalog/apigateway-account/main
  - catalog/backup/main-prod
  - catalog/acm/main-prod
  - catalog/secretsmanager/app-prod
  - catalog/secretsmanager/infra-prod
[[- end ]]

  # --- compute
[[- if $data_plane ]]
  - catalog/eks/main-prod
  - catalog/eks/data
  - catalog/github-runners/main-prod
  - catalog/ec2/bastion-prod
  - catalog/external-secrets/main-prod
  - catalog/external-secrets/data
  - catalog/eks-addons/main-prod
  - catalog/eks-addons/data
  - catalog/eks-backend-services/main-prod
[[- else ]]
  - catalog/eks/main-prod
  - catalog/github-runners/main-prod
  - catalog/ec2/bastion-prod
  - catalog/external-secrets/main-prod
  - catalog/eks-addons/main-prod
  - catalog/eks-backend-services/main-prod
[[- end ]]

  # --- services
[[- if $data_plane ]]
  - catalog/apigateway/main-prod
  - catalog/cognito/main-prod
  - catalog/monitoring/main-prod-data-plane
  - catalog/monitoring/data-prod
  - catalog/s3/lambda-artifacts
  - catalog/cost-optimization/main
  - catalog/rds/main-prod
  - catalog/rds/data-prod
  - catalog/elasticache/main-prod
  - catalog/apigateway/data
  - catalog/ecs/main
  - catalog/lambda/data-processor
  - catalog/lambda/data-transformer
  - catalog/sqs/data-transform
  - catalog/lambda/report-generator
[[- else ]]
  - catalog/cost-optimization/main-prod-eu
  - catalog/rds/main-prod
  - catalog/elasticache/main-prod
  - catalog/cognito/main-prod
  - catalog/apigateway/main-prod
  - catalog/monitoring/main-prod
[[- end ]]

vars:
  region: [[ .Config.region ]]
  tags:
    Team: "Platform"
    CostCenter: "Production"
    Project: "Infrastructure"
    ManagedBy: "Terraform"
    Tenant: "[[ .Config.tenant ]]"
    Application: "Production"
    Provisioner: "Atmos"
    DataClassification: "confidential"
    Compliance: "[[ if $gdpr ]]pci-sox-gdpr[[ else ]]pci-sox[[ end ]]"
    CriticalityLevel: "high"
    SLA: "99.9"
    BackupRequired: "true"

settings:
  # DR region of this primary (its warm standby [[ $standby ]]): the prod
  # catalog files template their replica copies and reads from it
  # (catalog/secretsmanager/{app,infra}-prod, catalog/kms/main-prod,
  # catalog/backup/main-prod). Not settings.tfstate.replica_region, the
  # state bucket's replica.
  dr:
    region: [[ .Config.dr_region ]]
  context:
    tenant: [[ .Config.tenant ]]
    stage: [[ .Config.stage ]]
  environment:
    account: [[ $account ]]
    # The stack's one domain (every zone, record, certificate and API domain
    # derives from it)[[ if $gdpr ]]: a separate EU apex owned by the prod-eu
    # account, never a name under the US domain[[ end ]].
    domain_name: "[[ .Config.domain_name ]]"
    # Alert contacts and the account's monthly budget (cost-optimization/main).
    monitoring:
      critical_alerts:
[[- range splitList "," .Config.critical_alerts ]]
        - "[[ . ]]"
[[- end ]]
      warning_alerts:
[[- range splitList "," .Config.warning_alerts ]]
        - "[[ . ]]"
[[- end ]]
[[- if $data_plane ]]
      pagerduty_service_key_ssm_parameter: /[[ .Config.tenant ]]/production/pagerduty/service_key
[[- end ]]
      budget_monthly_limit: "[[ .Config.budget_monthly_limit ]]"
    eks_kubernetes_version: "1.36"
    eks_public_access: false
    rds_engine: "postgres"
    rds_engine_version: "14"
    use_external_secrets: true
    # eks-backend-services/main's images, the release pipeline's: the same
    # release in every region. Placeholders until it publishes them
    # (docs/OPERATIONS.md, "First-deploy inputs", Backend service images).
    backend_service_images:
      api_gateway: "ghcr.io/fnx-platform/api-gateway:1.4.2"
      platform_api: "ghcr.io/fnx-platform/platform-api:1.4.2"
      auth_service: "ghcr.io/fnx-platform/auth-service:1.4.2"
      job_processor: "ghcr.io/fnx-platform/job-processor:1.4.2"
[[- if $data_plane ]]
    enable_vpc_flow_logs: true
[[- end ]]
[[- if $gdpr ]]
  # The EU backend, overriding every settings.tfstate key (literal
  # .settings.context.* references only, see stacks/orgs/fnx/_defaults.yaml):
  # the same values as fnx-ew1-root's, which owns it.
  tfstate:
    region: eu-west-1
    replica_region: eu-central-1
    bucket: '{{ .settings.context.tenant }}-ew1-terraform-state'
    role_prefix: '{{ .settings.context.tenant }}-ew1-terraform-backend'
    stack: '{{ .settings.context.tenant }}-ew1-root'
[[- end ]]
[[- if $data_plane ]]
  # The two VPCs' CIDRs, in one place: each vpc instance's
  # ipv4_primary_cidr_block, vpc/main's private_network_acl_peer_cidr_blocks
  # and network/vpc-peering's routes read them. Literals, not
  # !terraform.state <vpc> .vpc_cidr: the vpcs would read each other, a cycle.
[[- end ]]
  network:
    vpc_cidrs:
      main: "[[ .Config.vpc_cidr_main ]]"
[[- if $data_plane ]]
      services: "[[ .Config.vpc_cidr_services ]]"
[[- end ]]

components:
  terraform:
    # ========================================================================
    # Globals
    # ========================================================================
    # Human cluster admins of [[ if $data_plane ]]every eks instance (eks/main and eks/data
    # inherit eks/defaults)[[ else ]]eks/main[[ end ]]: each rolearn, an IAM role in this
    # account, must also be in the state backend's access_roles.prod_write
    # allowed_principal_arns; check-cluster-api-ci.py fails one that is not,
    # and warns while this is empty. Empty until the owner supplies the ARN.
    eks/defaults:
      vars:
        map_additional_iam_roles: []

    # ========================================================================
    # Networking
    #
[[- if $data_plane ]]
    # vpc/main and vpc/services with three AZs, a NAT gateway per AZ and flow
    # logs (catalog/vpc/<i>-prod), peered by network/vpc-peering; the apex
    # zone network/main (catalog/network/main-prod-data-plane: its records
    # read the data plane) and network/services' zones
    # (catalog/network/services-prod).
[[- else ]]
    # vpc/main with three AZs, a NAT gateway per AZ and flow logs
    # (catalog/vpc/main-prod), and the apex zone network/main
    # (catalog/network/main-prod, settings.environment.domain_name).
[[- end ]]
[[- if $gdpr ]]
    # Everything stays in [[ .Config.region ]] (check-data-residency.py): Route 53
    # public query logging is off, its log group can only be in us-east-1.
[[- end ]]
    # This file keeps the CIDR[[ if $data_plane ]]s[[ end ]], AZs, subnets and the zones' values.
    # ========================================================================
    vpc/main:
      vars:
[[- if $data_plane ]]
        # The private NACL admits vpc/services, peered by network/vpc-peering.
        private_network_acl_peer_cidr_blocks:
          - "{{ .settings.network.vpc_cidrs.services }}"
[[- end ]]
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $net ]].1.0/24"
          - "[[ $net ]].2.0/24"
          - "[[ $net ]].3.0/24"
        public_subnets:
          - "[[ $net ]].101.0/24"
          - "[[ $net ]].102.0/24"
          - "[[ $net ]].103.0/24"
        database_subnets:
          - "[[ $net ]].201.0/24"
          - "[[ $net ]].202.0/24"
          - "[[ $net ]].203.0/24"
[[- if $data_plane ]]

    vpc/services:
      vars:
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $svc ]].1.0/24"
          - "[[ $svc ]].2.0/24"
          - "[[ $svc ]].3.0/24"
        public_subnets:
          - "[[ $svc ]].101.0/24"
          - "[[ $svc ]].102.0/24"
          - "[[ $svc ]].103.0/24"
        database_subnets:
          - "[[ $svc ]].201.0/24"
          - "[[ $svc ]].202.0/24"
          - "[[ $svc ]].203.0/24"

    # Query log groups (us-east-1): prod keeps 90 days, like eks's
    # cluster_log_retention_period.
    network/main:
      vars:
        query_log_retention_in_days: 90
        zones:
          main:
            comment: "Production main zone"
            enable_query_logging: true
          internal:
            comment: "Production internal DNS"

    network/services:
      vars:
        query_log_retention_in_days: 90
        zones:
          services:
            comment: "Production services zone"
            enable_query_logging: true
          data:
            comment: "Data services DNS"
[[- else ]]

    network/main:
      vars:
        zones:
          main:
            comment: "EU production main zone"
            # Off for every EU zone: Route 53 writes query logs only to
            # us-east-1.
            enable_query_logging: false
          internal:
            comment: "EU production internal DNS"
[[- end ]]

    # ========================================================================
    # Security
    #
    # The account and identity layer (iam/main, iam/ci), the stack's key
    # (kms/main), the account's singletons (cloudtrail/main's multi-region
    # trail, awsconfig/main's global-resource recording) and the regional
    # security services, each from its catalog/<c>/<i>[-prod] file. DR copies
    # (kms/main's replica, backup/main's copies, the secrets' replicas) go to
    # settings.dr.region, [[ .Config.dr_region ]].
[[- if $gdpr ]]
    # Every finding stays in [[ .Config.region ]]: no Security Hub cross-region
    # aggregation, no GuardDuty export, no enrichment Lambda
    # (check-data-residency.py).
[[- end ]]
    # This file keeps kms/main's description and replica alias[[ if $data_plane ]], iam/ci's
    # Lambda package uploader and acm/services' SAN[[ end ]].
    # ========================================================================
[[- if $data_plane ]]
    iam/ci:
      vars:
        # Lambda package uploader (<prefix>-lambda-uploader): the application
        # repo's CI uploads each function's zip to this stage's
        # s3/lambda-artifacts bucket with it (docs/OPERATIONS.md, "Lambda
        # packages"). No role until the app repo is named here as
        # "<org>/<repo>:<branch>" - an owner input. The alias is kms/main's,
        # the bucket's key (check-lambda-packages.py).
        lambda_uploader_trusted_github_repos: []
        lambda_uploader_kms_key_alias: "alias/{{ .settings.prefix }}-main"
[[- end ]]
    kms/main:
      vars:
[[- if $data_plane ]]
        description: Production main encryption key (EKS secrets, EC2/EBS, RDS)
[[- else ]]
        description: EU production main encryption key
        # cost-optimization/main's budget and anomaly notifications publish to
        # its cost-alerts topic on this key (billing_notifications_sns_enabled).
        allow_billing_notifications: true
[[- end ]]
        # Replicated to the DR region (catalog/kms/main-prod's replica_regions
        # is settings.dr.region): [[ $standby ]] reads the replica's ARN
        # cross-stack and reaches it by its own prefix's alias.
        replica_alias_names:
          [[ .Config.dr_region ]]: [[ .Config.dr_region_code ]]-main
[[- if $data_plane ]]

    acm/services:
      vars:
        dns_domains:
          services_wildcard:
            subject_alternative_names:
              - "api.services.{{ .settings.environment.domain_name }}"
            # No data.services SAN: *.services covers it, and its validation
            # record would sit in the services zone while the name belongs to
            # network/services' own data zone.
[[- end ]]

    # ========================================================================
    # Compute
    #
    # The main cluster and what runs around it, from the shared prod instance
    # files: eks/main ([[ .Config.region_code ]]-main), the in-VPC runner pool, the bastion,
    # and the in-cluster external-secrets/main, eks-addons/main and
    # eks-backend-services/main. The endpoint is private, so CI runs the
    # in-cluster instances on this stack's own pool (owner decision Q8).
[[- if $data_plane ]]
    # The data plane's cluster eks/data and its external-secrets/data and
    # eks-addons/data come from the un-suffixed catalog/<c>/data files.
    # This file keeps eks/data's tags, logs and node groups, the bastion's
    # egress rules, and the data plane's switches and log retention.
[[- else ]]
    # This file keeps the bastion's egress rules.
[[- end ]]
    # ========================================================================
[[- if $data_plane ]]
    eks/data:
      vars:
        tags:
          Cluster: "{{ .settings.prefix }}-data"
          Purpose: "data-processing"
        enabled_cluster_log_types:
          - "api"
          - "audit"
        cluster_log_retention_period: 90
        node_groups:
          # Data processing workers
          data-workers:
            instance_types: ["r5.2xlarge"]
            desired_group_size: 4
            min_group_size: 3
            max_group_size: 8
            kubernetes_labels:
              role: data-processing
            capacity_type: "ON_DEMAND"
            block_device_map:
              "/dev/xvda":
                ebs:
                  volume_size: 200
          # Batch processing (spot for cost savings)
          batch-workers:
            instance_types: ["m5.2xlarge", "m5.xlarge"]
            desired_group_size: 2
            min_group_size: 0
            max_group_size: 10
            kubernetes_labels:
              role: batch
            kubernetes_taints:
              - key: workload
                value: batch
                effect: "NO_SCHEDULE"
            capacity_type: "SPOT"
            block_device_map:
              "/dev/xvda":
                ebs:
                  volume_size: 100

    # The SSH rule names vpc/main's and vpc/services' CIDRs.
[[- else ]]
    # The SSH rule names this stack's one VPC.
[[- end ]]
    ec2/bastion:
      vars:
        allowed_egress_rules:
          - from_port: 443
            to_port: 443
            protocol: "tcp"
            cidr_blocks: ["0.0.0.0/0"]
            description: "HTTPS outbound"
          - from_port: 22
            to_port: 22
            protocol: "tcp"
[[- if $data_plane ]]
            cidr_blocks: ["[[ .Config.vpc_cidr_main ]]", "[[ .Config.vpc_cidr_services ]]"]
[[- else ]]
            cidr_blocks: ["{{ .settings.network.vpc_cidrs.main }}"]
[[- end ]]
            description: "SSH to VPC resources"
[[- if $data_plane ]]

    external-secrets/data:
      vars:
        enabled: true

    # EKS add-ons on eks/data: Container Insights keeps 90 days in prod.
    eks-addons/data:
      vars:
        clusters:
          data:
            container_insights_log_retention_days: 90
[[- end ]]

    # ========================================================================
    # Services
    #
[[- if $data_plane ]]
    # The serving path (rds/main, elasticache/main, cognito/main,
    # apigateway/main, each from its -prod file, and monitoring/main from
    # main-prod-data-plane: main-prod plus the ecs/main read), the data plane
    # (rds/data and monitoring/data from their -prod files; apigateway/data,
    # ecs/main, the lambdas, sqs/data-transform and s3/lambda-artifacts from
    # the un-suffixed defaults) and the account budget
    # (catalog/cost-optimization/main). [[ $standby ]] is its DR warm
    # standby: elasticache/main is a Global Datastore primary, rds/main the
    # source of the standby's read replica, cognito/main has the dr-migration
    # client the standby's user-migration trigger signs in with, and
    # apigateway/main is the PRIMARY half of api.<domain>'s Route 53 failover
    # pair.
    # This file keeps the health check alarm's actions, the data API's name,
    # description, resources, throttling, retention, tracing and tags, the
    # ECS cluster's name and Container Insights, the lambdas' sizes,
    # concurrency and environment, the queue's visibility timeout,
    # monitoring/data's recipients and the budget's standby tag.
    # ========================================================================
    apigateway/main:
      vars:
        # The health check's alarm lives in us-east-1 (Route 53's metrics are
        # only there) and notifies monitoring/main's topic, by name: that
        # component reads this one, so a !terraform.state here would be a cycle.
        health_check_alarm_actions:
          - "arn:aws:sns:us-east-1:{{ .settings.environment.account_id }}:{{ .settings.prefix }}-main-alarms"

    apigateway/data:
      vars:
        api_name: "{{ .settings.context.stage }}-data-api"
        description: "Production Data API Gateway"
        api_resources:
          - path_part: "data"
          - path_part: "metrics"
          - path_part: "analytics"
          - path_part: "reports"
        throttling_burst_limit: 2000
        throttling_rate_limit: 5000
        log_retention_days: 90
        tracing_enabled: true
        tags:
          Service: data-api
          Tier: backend

    ecs/main:
      vars:
        cluster_name: "{{ .settings.context.stage }}-main-apps"
        enable_container_insights: true

    lambda/data-processor:
      vars:
        memory_size: 1024
        timeout: 600
        reserved_concurrent_executions: 100
        environment_variables:
          LOG_LEVEL: "INFO"
          ENVIRONMENT: "{{ .settings.context.stage }}"

    # sqs/data-transform's visibility_timeout_seconds is derived from this
    # timeout: change them together.
    lambda/data-transformer:
      vars:
        memory_size: 2048
        timeout: [[ $transformer_timeout ]]
        reserved_concurrent_executions: 50
        # maximum_concurrency stays within reserved_concurrent_executions, so
        # the poller backs off instead of being throttled.
        event_source_mappings:
          data-transform:
            scaling_config:
              maximum_concurrency: 50

    sqs/data-transform:
      vars:
        # AWS: at least 6x the consumer's timeout plus its batching window,
        # 6 x [[ $transformer_timeout ]] (lambda/data-transformer timeout) + 5 = [[ add 5 (mul 6 $transformer_timeout) ]].
        visibility_timeout_seconds: [[ add 5 (mul 6 $transformer_timeout) ]]

    # The data dashboard's and alarms' recipients: the first critical alert
    # and the data team's list (a placeholder: set the real address).
    monitoring/data:
      vars:
        alarm_email_subscriptions:
          - "[[ index (splitList "," .Config.critical_alerts) 0 ]]"
          - "data-team@example.com"

    # The account's budget (catalog/cost-optimization/main; no instance
    # scheduler in prod) also counts its DR standby [[ $standby ]] (same
    # account, no budget of its own); lint check-dr-pairs (dr-pair.py --lint)
    # fails a standby missing here.
    cost-optimization/main:
      vars:
        budget_additional_environment_tags: ["[[ .Config.dr_region_code ]]"]
[[- else ]]
    # The serving path (rds/main, elasticache/main, cognito/main,
    # apigateway/main, monitoring/main, each from its -prod file) and the
    # account budget. [[ $standby ]] is its DR warm standby: elasticache/main
    # is a Global Datastore primary, rds/main the source of the standby's read
    # replica, cognito/main has the dr-migration client the standby's
    # user-migration trigger signs in with, and apigateway/main is the
    # PRIMARY half of api.<domain>'s Route 53 failover pair.
[[- if $gdpr ]]
    # cognito/main is the prod-eu account's own user pool, never a migration
    # from a US primary's (owner decision): EU users sign up here.
[[- end ]]
    # This file keeps the health check's checker and relay regions, the
    # relayed alarms' receipt and the budget's standby tag.
    # ========================================================================
    apigateway/main:
      vars:
        # The checkers: eu-west-1, the only EU checker region, plus two others
        # (Route 53 needs three): probes of the API's stage root, a residency
        # exemption (check-data-residency.py EXEMPTIONS).
        health_check_regions: ["eu-west-1", "us-east-1", "ap-southeast-1"]
        # The health check's alarm lives in us-east-1 (Route 53's metrics are
        # only there) and notifies nothing there: EventBridge relays its state
        # changes to the default bus of both EU regions, where each
        # monitoring/main delivers them to its topic. Owner decision B5.
[[- if $gdpr ]]
        # Allowed under data residency: what sits in us-east-1 for it is the
        # health check, its alarm, and an EventBridge rule, its targets and
        # their IAM role (configuration only: nothing persisted, no personal
        # data). Relaying to both EU regions means an outage of
        # [[ .Config.region ]], the one this alarm reports, still reaches
        # [[ .Config.dr_region_code ]]-main-alarms.
[[- end ]]
        health_check_alarm_relay_regions: ["[[ .Config.region ]]", "[[ .Config.dr_region ]]"]

    # Owns [[ .Config.region_code ]]-main-alarms, the topic the runner pool's alarms name,
    # and delivers the relayed us-east-1 health check alarms of the failover
    # pair to it (apigateway/main).
    monitoring/main:
      vars:
        receive_relayed_health_check_alarms: true

    # The budget and the anomaly subscription notify the [[ .Config.region ]]
    # cost-alerts topic (catalog/cost-optimization/main-prod-eu). The
    # account's budget also counts its DR standby [[ $standby ]] (same account,
    # no budget of its own); lint check-dr-pairs (dr-pair.py --lint) fails a
    # standby missing here.
    cost-optimization/main:
      vars:
        budget_additional_environment_tags: ["[[ .Config.dr_region_code ]]"]
[[- end ]]
