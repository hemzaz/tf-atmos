[[- $account := default .Config.stage .Config.account -]]
[[- $gdpr := eq $account "prod-eu" -]]
[[- $data_plane := eq .Config.data_plane "yes" -]]
[[- if or $data_plane (not $gdpr) ]][[ fail "prod-primary: only the prod-eu account's EU primary without the data plane (fnx-ew1-prod's branch) is in the template yet" ]][[ end -]]
[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $standby := printf "%s-%s-%s" .Config.tenant .Config.dr_region_code .Config.stage -]]
[[- $net := trimSuffix ".0.0/16" .Config.vpc_cidr_main -]]
---
# =============================================================================
# [[ $stack ]]: the [[ $account ]] account's prod primary, [[ .Config.region ]]
# =============================================================================
# The account's primary prod stack. Its DR warm standby is [[ $standby ]]
# (settings.dr.region [[ .Config.dr_region ]]), in the same account.
[[- if $gdpr ]]
#
# GDPR-scoped (account prod-eu, owner decision B5): EU personal data lives
# only in EU stacks. Tagged Compliance "pci-sox-gdpr" (vars.tags below);
# check-data-residency.py fails it if it names a non-EU region or depends on
# a US stack. Its state is in the EU backend, fnx-ew1-root's backend/main
# (stacks/orgs/fnx/root/eu-west-1.yaml), through its prod_read/prod_write
# roles.
[[- end ]]
#
# It owns the account's singletons: the GitHub OIDC provider (iam/ci), the
# Auto Scaling service-linked role (iam/main), the multi-region CloudTrail
# trail, AWS Config's global-resource recording and the account budget
# (cost-optimization/main, which also counts [[ $standby ]]).
#
# First deploy: docs/OPERATIONS.md ("Deploying a stack"), with
# administrator credentials in the [[ $account ]] account:
#   atmos workflow full -f bootstrap -s [[ $stack ]]
#
# Generated by `atmos scaffold generate stack` (scaffolds/stack, profile
# prod-primary[[ if not $data_plane ]], no data plane: fnx-ew1-prod's core subset[[ end ]]). One file per
# stack: the imports, then one vars/settings/components body, grouped by
# domain (globals, networking, security, compute, services). Every
# instance's wiring is its catalog/<component>/<instance>-prod file (-prod-eu
# for the prod-eu account's budget); each domain section below says what
# this file keeps.
# =============================================================================

import:
  - catalog/_base/defaults
  # Region mixin: region [[ .Config.region ]], environment (region code) [[ .Config.region_code ]]
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults

  # --- globals: catalog defaults (the rest come with their instances)
  - catalog/iam/defaults
  - catalog/vpc/defaults
  - catalog/network/defaults
  - catalog/eks/defaults

  # --- networking
  - catalog/vpc/main-prod
  - catalog/network/main-prod

  # --- security
  - catalog/iam/main-prod
  - catalog/iam/ci-prod
  - catalog/kms/main-prod
  - catalog/cloudtrail/main
  - catalog/awsconfig/main
  - catalog/guardduty/main-prod
  - catalog/securityhub/main-prod
  - catalog/inspector2/main
  - catalog/security-monitoring/main
  - catalog/apigateway-account/main
  - catalog/backup/main-prod
  - catalog/acm/main-prod
  - catalog/secretsmanager/app-prod
  - catalog/secretsmanager/infra-prod

  # --- compute
  - catalog/eks/main-prod
  - catalog/github-runners/main-prod
  - catalog/ec2/bastion-prod
  - catalog/external-secrets/main-prod
  - catalog/eks-addons/main-prod
  - catalog/eks-backend-services/main-prod

  # --- services
  - catalog/cost-optimization/main-prod-eu
  - catalog/rds/main-prod
  - catalog/elasticache/main-prod
  - catalog/cognito/main-prod
  - catalog/apigateway/main-prod
  - catalog/monitoring/main-prod

vars:
  region: [[ .Config.region ]]
  tags:
    Team: "Platform"
    CostCenter: "Production"
    Project: "Infrastructure"
    ManagedBy: "Terraform"
    Tenant: "[[ .Config.tenant ]]"
    Application: "Production"
    Provisioner: "Atmos"
    DataClassification: "confidential"
    Compliance: "[[ if $gdpr ]]pci-sox-gdpr[[ else ]]pci-sox[[ end ]]"
    CriticalityLevel: "high"
    SLA: "99.9"
    BackupRequired: "true"

settings:
  # DR region of this primary (its warm standby [[ $standby ]]): the prod
  # catalog files template their replica copies and reads from it
  # (catalog/secretsmanager/{app,infra}-prod, catalog/kms/main-prod,
  # catalog/backup/main-prod). Not settings.tfstate.replica_region, the
  # state bucket's replica.
  dr:
    region: [[ .Config.dr_region ]]
  context:
    tenant: [[ .Config.tenant ]]
    stage: [[ .Config.stage ]]
  environment:
    account: [[ $account ]]
    # The stack's one domain (every zone, record, certificate and API domain
    # derives from it)[[ if $gdpr ]]: a separate EU apex owned by the prod-eu
    # account, never a name under the US domain[[ end ]].
    domain_name: "[[ .Config.domain_name ]]"
    # Alert contacts and the account's monthly budget (cost-optimization/main).
    monitoring:
      critical_alerts:
[[- range splitList "," .Config.critical_alerts ]]
        - "[[ . ]]"
[[- end ]]
      warning_alerts:
[[- range splitList "," .Config.warning_alerts ]]
        - "[[ . ]]"
[[- end ]]
      budget_monthly_limit: "[[ .Config.budget_monthly_limit ]]"
    eks_kubernetes_version: "1.36"
    eks_public_access: false
    rds_engine: "postgres"
    rds_engine_version: "14"
    use_external_secrets: true
    # eks-backend-services/main's images, the release pipeline's: the same
    # release in every region. Placeholders until it publishes them
    # (docs/OPERATIONS.md, "First-deploy inputs", Backend service images).
    backend_service_images:
      api_gateway: "ghcr.io/fnx-platform/api-gateway:1.4.2"
      platform_api: "ghcr.io/fnx-platform/platform-api:1.4.2"
      auth_service: "ghcr.io/fnx-platform/auth-service:1.4.2"
      job_processor: "ghcr.io/fnx-platform/job-processor:1.4.2"
[[- if $gdpr ]]
  # The EU backend, overriding every settings.tfstate key (literal
  # .settings.context.* references only, see stacks/orgs/fnx/_defaults.yaml):
  # the same values as fnx-ew1-root's, which owns it.
  tfstate:
    region: eu-west-1
    replica_region: eu-central-1
    bucket: '{{ .settings.context.tenant }}-ew1-terraform-state'
    role_prefix: '{{ .settings.context.tenant }}-ew1-terraform-backend'
    stack: '{{ .settings.context.tenant }}-ew1-root'
[[- end ]]
  network:
    vpc_cidrs:
      main: "[[ .Config.vpc_cidr_main ]]"

components:
  terraform:
    # ========================================================================
    # Globals
    # ========================================================================
    # Human cluster admins of eks/main: each rolearn, an IAM role in this
    # account, must also be in the state backend's access_roles.prod_write
    # allowed_principal_arns; check-cluster-api-ci.py fails one that is not,
    # and warns while this is empty. Empty until the owner supplies the ARN.
    eks/defaults:
      vars:
        map_additional_iam_roles: []

    # ========================================================================
    # Networking
    #
    # vpc/main with three AZs, a NAT gateway per AZ and flow logs
    # (catalog/vpc/main-prod), and the apex zone network/main
    # (catalog/network/main-prod, settings.environment.domain_name).
[[- if $gdpr ]]
    # Everything stays in [[ .Config.region ]] (check-data-residency.py): Route 53
    # public query logging is off, its log group can only be in us-east-1.
[[- end ]]
    # This file keeps the CIDR, AZs, subnets and the zones' values.
    # ========================================================================
    vpc/main:
      vars:
        # AZ IDs, not names: see components/terraform/vpc/README.md.
        availability_zone_ids:
[[- range splitList "," .Config.az_ids ]]
          - [[ . ]]
[[- end ]]
        private_subnets:
          - "[[ $net ]].1.0/24"
          - "[[ $net ]].2.0/24"
          - "[[ $net ]].3.0/24"
        public_subnets:
          - "[[ $net ]].101.0/24"
          - "[[ $net ]].102.0/24"
          - "[[ $net ]].103.0/24"
        database_subnets:
          - "[[ $net ]].201.0/24"
          - "[[ $net ]].202.0/24"
          - "[[ $net ]].203.0/24"

    network/main:
      vars:
        zones:
          main:
            comment: "EU production main zone"
            # Off for every EU zone: Route 53 writes query logs only to
            # us-east-1.
            enable_query_logging: false
          internal:
            comment: "EU production internal DNS"

    # ========================================================================
    # Security
    #
    # The account and identity layer (iam/main, iam/ci), the stack's key
    # (kms/main), the account's singletons (cloudtrail/main's multi-region
    # trail, awsconfig/main's global-resource recording) and the regional
    # security services, each from its catalog/<c>/<i>[-prod] file. DR copies
    # (kms/main's replica, backup/main's copies, the secrets' replicas) go to
    # settings.dr.region, [[ .Config.dr_region ]].
[[- if $gdpr ]]
    # Every finding stays in [[ .Config.region ]]: no Security Hub cross-region
    # aggregation, no GuardDuty export, no enrichment Lambda
    # (check-data-residency.py).
[[- end ]]
    # This file keeps kms/main's description and replica alias.
    # ========================================================================
    kms/main:
      vars:
        description: EU production main encryption key
        # cost-optimization/main's budget and anomaly notifications publish to
        # its cost-alerts topic on this key (billing_notifications_sns_enabled).
        allow_billing_notifications: true
        # Replicated to the DR region (catalog/kms/main-prod's replica_regions
        # is settings.dr.region): [[ $standby ]] reads the replica's ARN
        # cross-stack and reaches it by its own prefix's alias.
        replica_alias_names:
          [[ .Config.dr_region ]]: [[ .Config.dr_region_code ]]-main

    # ========================================================================
    # Compute
    #
    # The main cluster and what runs around it, from the shared prod instance
    # files: eks/main ([[ .Config.region_code ]]-main), the in-VPC runner pool, the bastion,
    # and the in-cluster external-secrets/main, eks-addons/main and
    # eks-backend-services/main. The endpoint is private, so CI runs the
    # in-cluster instances on this stack's own pool (owner decision Q8).
    # This file keeps the bastion's egress rules.
    # ========================================================================
    # The SSH rule names this stack's one VPC.
    ec2/bastion:
      vars:
        allowed_egress_rules:
          - from_port: 443
            to_port: 443
            protocol: "tcp"
            cidr_blocks: ["0.0.0.0/0"]
            description: "HTTPS outbound"
          - from_port: 22
            to_port: 22
            protocol: "tcp"
            cidr_blocks: ["{{ .settings.network.vpc_cidrs.main }}"]
            description: "SSH to VPC resources"

    # ========================================================================
    # Services
    #
    # The serving path (rds/main, elasticache/main, cognito/main,
    # apigateway/main, monitoring/main, each from its -prod file) and the
    # account budget. [[ $standby ]] is its DR warm standby: elasticache/main
    # is a Global Datastore primary, rds/main the source of the standby's read
    # replica, cognito/main has the dr-migration client the standby's
    # user-migration trigger signs in with, and apigateway/main is the
    # PRIMARY half of api.<domain>'s Route 53 failover pair.
    # This file keeps the health check's checker and relay regions, the
    # relayed alarms' receipt and the budget's standby tag.
    # ========================================================================
    apigateway/main:
      vars:
        # The checkers: eu-west-1, the only EU checker region, plus two others
        # (Route 53 needs three): probes of the API's stage root, a residency
        # exemption (check-data-residency.py EXEMPTIONS).
        health_check_regions: ["eu-west-1", "us-east-1", "ap-southeast-1"]
        # The health check's alarm lives in us-east-1 (Route 53's metrics are
        # only there) and notifies nothing there: EventBridge relays its state
        # changes to the default bus of both EU regions, where each
        # monitoring/main delivers them to its topic. Owner decision B5.
        health_check_alarm_relay_regions: ["[[ .Config.region ]]", "[[ .Config.dr_region ]]"]

    # Owns [[ .Config.region_code ]]-main-alarms, the topic the runner pool's alarms name,
    # and delivers the relayed us-east-1 health check alarms of the failover
    # pair to it (apigateway/main).
    monitoring/main:
      vars:
        receive_relayed_health_check_alarms: true

    # The budget and the anomaly subscription notify the [[ .Config.region ]]
    # cost-alerts topic (catalog/cost-optimization/main-prod-eu). The
    # account's budget also counts its DR standby [[ $standby ]] (same account,
    # no budget of its own); lint check-dr-pairs (dr-pair.py --lint) fails a
    # standby missing here.
    cost-optimization/main:
      vars:
        budget_additional_environment_tags: ["[[ .Config.dr_region_code ]]"]
