[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $home := eq .Config.region "us-east-1" -]]
[[- /* The EU core stacks: scripts/stack-wiring.py EU_CORE_STACKS (the scaffold's guard hook allows no other eu- stage and region for a core stack): eu-west-1, the EU home, and eu-central-1, the EU DR region (security only, E5c OQ-R). */ -]]
[[- $eu := hasPrefix "eu-" .Config.region -]]
[[- $ew1 := eq .Config.region "eu-west-1" -]]
[[- $root := printf "%s-%s-root" .Config.tenant (ternary "ew1" "ue1" $eu) -]]
[[- /* The management account's stack in this stack's region: the org security services' root step (E5c). */ -]]
[[- $delegator := printf "%s-%s-root" .Config.tenant .Config.region_code -]]
[[- $archive := and (eq .Config.stage "audit") (or $home $ew1) -]]
[[- /* fnx-ew1-security holds the EU Config aggregator (E5c OQ-EA): its own collector, aws-config/security-eu. */ -]]
[[- $eu_aggregator := and $ew1 (eq .Config.stage "security") -]]
[[- /* Every other EU core stack's recorder authorizes the EU aggregator (owner 2026-11-13): aws-config/main-core-region-eu. */ -]]
[[- $eu_shared := and $eu (not $eu_aggregator) -]]
[[- $recorder := ternary (ternary "security" "main" (eq .Config.stage "security")) (ternary "security-eu" (ternary "main-core-region-eu" "main-core-region" $eu_shared) $eu_aggregator) $home -]]
---
# =============================================================================
# [[ $stack ]] - the [[ .Config.stage ]] account's [[ .Config.region ]] stack
# =============================================================================
[[- if $archive ]]
# A core-account stack (owner decision QE5): its stage defaults'
# aws-account-settings, and the [[ ternary "EU" "US" $eu ]] log archive (E5a, one per residency,
# owner decision QE7): the cloudtrail-bucket, config-bucket and its
# kms/config-bucket key from the imported catalogs (aws-config-bucket/[[ ternary "main-eu" "main" $eu ]]
# for the [[ ternary "EU" "US" $eu ]] delivery accounts). The key is in the kms layer, the buckets in
# the storage layer (workflows/deploy-full-stack.yaml).
[[- else ]]
# A core-account stack (owner decision QE5): its stage defaults'
# aws-account-settings, and the account's [[ if $home ]]trail and [[ end ]]Config recorder below.
[[- end ]]
[[- if $home ]]
#
# The account's one multi-region trail (cloudtrail, from
# catalog/aws-cloudtrail/defaults; owner OQ-A, check-lane-names.py SINGLETONS),
# delivering to [[ .Config.tenant ]]-ue1-audit's cloudtrail-bucket, and its Config recorder
# (aws-config, inheriting aws-config/[[ $recorder ]]), the account's global-resource
# collector, delivering to [[ .Config.tenant ]]-ue1-audit's config-bucket
[[- if eq $recorder "security" ]]; it also holds the US
# account aggregator (owner OQ-B: every account but prod-eu)
[[- end ]]. Both are in
# deploy-full-stack's security layer, after the audit stack's storage layer
# (docs/OPERATIONS.md "Bootstrap order").
[[- else if $eu_aggregator ]]
#
# The account's Config recorder for [[ .Config.region ]] (aws-config, inheriting
# aws-config/security-eu, owner OQ-EA): its own global-resource collector, with
# its own role, delivering to [[ .Config.tenant ]]-ew1-audit's config-bucket, because it also
# holds the EU account aggregator (prod-eu), which Cloud Posse creates only in
# the collector region. No trail: the account's one multi-region trail, in its
# home stack, records this region (owner OQ-A).
[[- else ]]
#
# The account's Config recorder for [[ .Config.region ]] (aws-config, inheriting
# aws-config/[[ $recorder ]]): regional resource types only, with the recorder
# role of [[ .Config.tenant ]]-ue1-[[ .Config.stage ]], the account's global-resource collector, by
# its convention ARN (catalog/aws-config/main.yaml), so deploy that home stack
# first (docs/OPERATIONS.md "Bootstrap order").
[[- if $eu_shared ]] It authorizes the EU aggregator
# (security, eu-west-1, [[ .Config.tenant ]]-ew1-security; aggregator_authorization_region),
# never the US one: EU Config data stays in the EU (owner 2026-11-13).
#[[- end ]] No trail: the account's one
# multi-region trail, in its home stack, records this region (owner OQ-A).
[[- end ]]
[[- if eq .Config.stage "security" ]]
#
# The organization's GuardDuty detector and Security Hub hub for [[ .Config.region ]]
# (E5c4, Cloud Posse's step 1, delegated-administrator): [[ .Config.tenant ]]-security is
# their delegated administrator once [[ $delegator ]]'s root step delegates them
# (step 2); org-settings adds the members (step 3, below). Inspector has no step 1.
# The detector's protection plans, per catalog/aws-guardduty/defaults.yaml
# (owner OQ-GD): S3, EKS audit logs and EBS malware scanning, findings every
# FIFTEEN_MINUTES. Security Hub (catalog/aws-security-hub/[[ ternary "defaults" "us" $eu ]].yaml, owner
# OQ-SH): Cloud Posse's default standards,
[[- if $home ]] and the finding aggregator,
# linking us-east-2 only (SPECIFIED_REGIONS): no EU region's findings reach
# us-east-1.
[[- else if $eu ]] never aggregated: EU findings
# stay in their region (QE7).
[[- else ]] its findings aggregated into
# [[ .Config.tenant ]]-ue1-security's hub (us-east-1); it aggregates none.
[[- end ]]
#
# Step 3, org-settings (catalog aws-guardduty, aws-security-hub and
# aws-inspector2 [[ ternary "defaults" "us" $eu ]].yaml; security-org layer, after the root step):
# the members are the account map minus this account, the management account
# included (owner 2026-11-14, a deviation from Cloud Posse, which leaves it
# out);
[[- if $eu ]] here every account, prod-eu included: the EU admin is the
# all-GDPR accounts' (owner OQ-RES).
[[- else ]] here without prod-eu, whose EU personal data never reaches a US
# region (owner OQ-RES).
[[- end ]]
[[- if $ew1 ]] Security Hub suppresses the home-region-only IAM, KMS
# and CloudWatch controls for the shared accounts alone
# (eu-shared-account-suppressions; prod-eu's home is here).
[[- else if not $home ]] Security Hub suppresses the home-region-only
# IAM, KMS and CloudWatch controls for every account (standby-suppressions:
# no account's home region).
[[- end ]] Inspector's
# org-settings is committed disabled (owner OQ-IN).
[[- end ]]
#
# Its state goes to [[ $root ]]'s bucket
# through the backend's core role (stacks/orgs/[[ .Config.tenant ]]/_defaults.yaml),
# whose core_write trusts the management-account administrator and the
# [[ .Config.stage ]] account's OrganizationAccountAccessRole, and its stage
# defaults keep it out of every CI matrix (github.actions_enabled: false). The
# scaffold's wire hook added this stack's pattern pair to core_write
# (check-state-keys.py).
[[- if $eu ]]
#
# An EU core stack (owner decision 2026-11-03: stages audit and security in
[[- if $ew1 ]]
# eu-west-1, scripts/stack-wiring.py EU_CORE_STAGES/EU_CORE_REGIONS), in the
[[- else ]]
# eu-west-1; E5c OQ-R (a), 2026-11-10: security in [[ .Config.region ]], the EU DR
# region, scripts/stack-wiring.py EU_CORE_STACKS), in the
[[- end ]]
# same shared [[ .Config.stage ]] account: GDPR-scoped (check-data-residency.py),
# so tagged Compliance "pci-sox-gdpr", its recorder delivering to the EU
# archive ([[ .Config.tenant ]]-ew1-audit), and its state in the EU backend ([[ $root ]],
# stacks/orgs/[[ .Config.tenant ]]/root/eu-west-1.yaml), whose core_write trusts the
# [[ .Config.stage ]] account's OrganizationAccountAccessRole.
[[- end ]]
[[- if not $home ]]
#
# Not the account's home region (us-east-1, [[ .Config.tenant ]]-ue1-[[ .Config.stage ]]):
# aws-account-settings/main-standby, after the stage defaults, leaves the
# account-wide IAM account alias and S3 account public access block to the
# home-region stack (check-lane-names.py SINGLETONS).
[[- end ]]
# =============================================================================

import:
  - catalog/_base/defaults
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults
[[- if not $home ]]
  - catalog/aws-account-settings/main-standby
[[- end ]]
[[- if $archive ]]
  - catalog/aws-cloudtrail-bucket/defaults
  - catalog/aws-config-bucket/[[ ternary "main-eu" "main" $eu ]]
[[- end ]]
[[- if $home ]]
  - catalog/aws-cloudtrail/defaults
[[- end ]]
  - catalog/aws-config/[[ ternary "security-eu" "main" $eu_aggregator ]]
[[- if eq .Config.stage "security" ]]
  - catalog/aws-guardduty/[[ ternary "defaults" "us" $eu ]]
  - catalog/aws-security-hub/[[ ternary "defaults" "us" $eu ]]
  - catalog/aws-inspector2/[[ ternary "defaults" "us" $eu ]]
[[- end ]]
[[- if $eu ]]

vars:
  tags:
    Compliance: "pci-sox-gdpr"

settings:
  # The EU backend, overriding every settings.tfstate key (literal
  # .settings.context.* references only, see stacks/orgs/[[ .Config.tenant ]]/_defaults.yaml),
  # as [[ $root ]]'s own: the state stays in eu-west-1, replicated to
  # eu-central-1.
  tfstate:
    region: eu-west-1
    replica_region: eu-central-1
    bucket: '{{ .settings.context.tenant }}-ew1-terraform-state'
    role_prefix: '{{ .settings.context.tenant }}-ew1-terraform-backend'
    stack: '{{ .settings.context.tenant }}-ew1-root'
[[- end ]]

components:
  terraform:
    # Cloud Posse's instance name; the variant is catalog/aws-config/[[ ternary "security-eu" "main" $eu_aggregator ]].yaml's.
    aws-config:
      metadata:
        component: aws-config
        inherits:
          - aws-config/[[ $recorder ]]
[[- if eq .Config.stage "security" ]]
    # Cloud Posse's instance names, step 1 (admin_delegated false): the
    # delegated administrator's detector and hub.
    aws-guardduty/delegated-administrator:
      metadata:
        component: aws-guardduty
        inherits:
          - aws-guardduty/delegated-administrator-defaults
    aws-security-hub/delegated-administrator:
      metadata:
        component: aws-security-hub
        inherits:
          - aws-security-hub/delegated-administrator-[[ ternary "eu" "us" $eu ]]
    # Step 3 (admin_delegated true, deploy-full-stack's security-org layer,
    # after [[ $delegator ]]'s delegation): members and auto-enable. The
    # [[ ternary "-eu" "-us" $eu ]] variants' map [[ if $eu ]]holds every account, prod-eu included[[ else ]]leaves prod-eu out (owner OQ-RES)[[ end ]]; the
    # management account is a member too (owner 2026-11-14).
    aws-guardduty/org-settings:
      metadata:
        component: aws-guardduty
        inherits:
          - aws-guardduty/org-settings-[[ ternary "eu" "us" $eu ]]
    aws-security-hub/org-settings:
      metadata:
        component: aws-security-hub
        inherits:
          - aws-security-hub/org-settings-[[ ternary "eu" "us" $eu ]]
[[- if $ew1 ]]
          - aws-security-hub/eu-shared-account-suppressions
[[- else if not $home ]]
          - aws-security-hub/standby-suppressions
[[- end ]]
    # Delegated (root step) but scanning nothing yet (owner OQ-IN): turning
    # Inspector on is this flag.
    aws-inspector2/org-settings:
      metadata:
        component: aws-inspector2
        enabled: false
        inherits:
          - aws-inspector2/org-settings-[[ ternary "eu" "us" $eu ]]
[[- end ]]
