[[- $stack := printf "%s-%s-%s" .Config.tenant .Config.region_code .Config.stage -]]
[[- $home := eq .Config.region "us-east-1" -]]
[[- /* The EU core region: scripts/stack-wiring.py EU_CORE_REGIONS (the scaffold's guard hook allows no other eu- region for a core stack). */ -]]
[[- $eu := eq .Config.region "eu-west-1" -]]
[[- $root := printf "%s-%s-root" .Config.tenant (ternary "ew1" "ue1" $eu) -]]
[[- $archive := and (eq .Config.stage "audit") (or $home $eu) -]]
[[- /* fnx-ew1-security holds the EU Config aggregator (E5c OQ-EA): its own collector, aws-config/security-eu. */ -]]
[[- $eu_aggregator := and $eu (eq .Config.stage "security") -]]
[[- $recorder := ternary (ternary "security" "main" (eq .Config.stage "security")) (ternary "security-eu" "main-core-region" $eu_aggregator) $home -]]
---
# =============================================================================
# [[ $stack ]] - the [[ .Config.stage ]] account's [[ .Config.region ]] stack
# =============================================================================
[[- if $archive ]]
# A core-account stack (owner decision QE5): its stage defaults'
# aws-account-settings, and the [[ ternary "EU" "US" $eu ]] log archive (E5a, one per residency,
# owner decision QE7): the cloudtrail-bucket, config-bucket and its
# kms/config-bucket key from the imported catalogs (aws-config-bucket/[[ ternary "main-eu" "main" $eu ]]
# for the [[ ternary "EU" "US" $eu ]] delivery accounts). The key is in the kms layer, the buckets in
# the storage layer (workflows/deploy-full-stack.yaml).
[[- else ]]
# A core-account stack (owner decision QE5): its stage defaults'
# aws-account-settings, and the account's trail and Config recorder below.
[[- end ]]
[[- if $home ]]
#
# The account's one multi-region trail (cloudtrail, from
# catalog/aws-cloudtrail/defaults; owner OQ-A, check-lane-names.py SINGLETONS),
# delivering to [[ .Config.tenant ]]-ue1-audit's cloudtrail-bucket, and its Config recorder
# (aws-config, inheriting aws-config/[[ $recorder ]]), the account's global-resource
# collector, delivering to [[ .Config.tenant ]]-ue1-audit's config-bucket
[[- if eq $recorder "security" ]]; it also holds the US
# account aggregator (owner OQ-B: every account but prod-eu)
[[- end ]]. Both are in
# deploy-full-stack's security layer, after the audit stack's storage layer
# (docs/OPERATIONS.md "Bootstrap order").
[[- else if $eu_aggregator ]]
#
# The account's Config recorder for [[ .Config.region ]] (aws-config, inheriting
# aws-config/security-eu, owner OQ-EA): its own global-resource collector, with
# its own role, delivering to [[ .Config.tenant ]]-ew1-audit's config-bucket, because it also
# holds the EU account aggregator (prod-eu), which Cloud Posse creates only in
# the collector region. No trail: the account's one multi-region trail, in its
# home stack, records this region (owner OQ-A).
[[- else ]]
#
# The account's Config recorder for [[ .Config.region ]] (aws-config, inheriting
# aws-config/main-core-region): regional resource types only, with the recorder
# role of [[ .Config.tenant ]]-ue1-[[ .Config.stage ]], the account's global-resource collector, by
# its convention ARN (catalog/aws-config/main.yaml), so deploy that home stack
# first (docs/OPERATIONS.md "Bootstrap order"). No trail: the account's one
# multi-region trail, in its home stack, records this region (owner OQ-A).
[[- end ]]
#
# Its state goes to [[ $root ]]'s bucket
# through the backend's core role (stacks/orgs/[[ .Config.tenant ]]/_defaults.yaml),
# whose core_write trusts the management-account administrator and the
# [[ .Config.stage ]] account's OrganizationAccountAccessRole, and its stage
# defaults keep it out of every CI matrix (github.actions_enabled: false). The
# scaffold's wire hook added this stack's pattern pair to core_write
# (check-state-keys.py).
[[- if $eu ]]
#
# An EU core stack (owner decision 2026-11-03: stages audit and security in
# eu-west-1, scripts/stack-wiring.py EU_CORE_STAGES/EU_CORE_REGIONS), in the
# same shared [[ .Config.stage ]] account: GDPR-scoped (check-data-residency.py),
# so tagged Compliance "pci-sox-gdpr", its recorder delivering to the EU
# archive ([[ .Config.tenant ]]-ew1-audit)[[ if not $eu_aggregator ]] under the scoped OQ-A exemption for its US collector
# region[[ end ]], and its state in the EU backend ([[ $root ]],
# stacks/orgs/[[ .Config.tenant ]]/root/eu-west-1.yaml), whose core_write trusts the
# [[ .Config.stage ]] account's OrganizationAccountAccessRole.
[[- end ]]
[[- if not $home ]]
#
# Not the account's home region (us-east-1, [[ .Config.tenant ]]-ue1-[[ .Config.stage ]]):
# aws-account-settings/main-standby, after the stage defaults, leaves the
# account-wide IAM account alias and S3 account public access block to the
# home-region stack (check-lane-names.py SINGLETONS).
[[- end ]]
# =============================================================================

import:
  - catalog/_base/defaults
  - mixins/region/[[ .Config.region ]]
  - orgs/[[ .Config.tenant ]]/[[ .Config.stage ]]/_defaults
[[- if not $home ]]
  - catalog/aws-account-settings/main-standby
[[- end ]]
[[- if $archive ]]
  - catalog/aws-cloudtrail-bucket/defaults
  - catalog/aws-config-bucket/[[ ternary "main-eu" "main" $eu ]]
[[- end ]]
[[- if $home ]]
  - catalog/aws-cloudtrail/defaults
[[- end ]]
  - catalog/aws-config/[[ ternary "security-eu" "main" $eu_aggregator ]]
[[- if $eu ]]

vars:
  tags:
    Compliance: "pci-sox-gdpr"

settings:
  # The EU backend, overriding every settings.tfstate key (literal
  # .settings.context.* references only, see stacks/orgs/[[ .Config.tenant ]]/_defaults.yaml),
  # as [[ $root ]]'s own: the state stays in eu-west-1, replicated to
  # eu-central-1.
  tfstate:
    region: eu-west-1
    replica_region: eu-central-1
    bucket: '{{ .settings.context.tenant }}-ew1-terraform-state'
    role_prefix: '{{ .settings.context.tenant }}-ew1-terraform-backend'
    stack: '{{ .settings.context.tenant }}-ew1-root'
[[- end ]]

components:
  terraform:
    # Cloud Posse's instance name; the variant is catalog/aws-config/[[ ternary "security-eu" "main" $eu_aggregator ]].yaml's.
    aws-config:
      metadata:
        component: aws-config
        inherits:
          - aws-config/[[ $recorder ]]
