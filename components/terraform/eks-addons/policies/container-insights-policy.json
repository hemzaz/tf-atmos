{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteThisClustersContainerInsightsLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy"
      ],
      "Resource": ${jsonencode(log_group_arns)}
    }
  ]
}
