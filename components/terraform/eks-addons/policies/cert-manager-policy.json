{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GrantGetChange",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange"
      ],
      "Resource": "arn:${partition}:route53:::change/*"
    },
    {
      "Sid": "GrantListHostedZonesByName",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZonesByName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GrantChangeResourceRecordSets",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets"
      ],
      "Resource": ${jsonencode(hosted_zone_arns)}
    }
  ]
}
